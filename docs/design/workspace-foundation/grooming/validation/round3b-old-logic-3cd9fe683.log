# Round 3b old-logic proofs. Worktree /tmp/opus-r3b-old detached at 3cd9fe683 (lane head before round 3b = wave 4 b87a4e756 + record).
# Seams added to the old worktree for injection only, behaviour unchanged (git diff below).
diff --git a/internal/session/sessionfile.go b/internal/session/sessionfile.go
index 13f6c8384..1e1582f29 100644
--- a/internal/session/sessionfile.go
+++ b/internal/session/sessionfile.go
@@ -2908,9 +2908,13 @@ func (s *sessionFile) sync() {
 	}
 	// A filesystem that cannot sync (a tmpfs, a pipe) has already done all it
 	// can, as Close says.
-	_ = s.file.Sync()
+	_ = syncJournal(s.file)
 }
 
+// syncJournal is the seam the round-3b proof injects a failing sync through;
+// the old logic's behaviour is unchanged.
+var syncJournal = func(f *os.File) error { return f.Sync() }
+
 // Close flushes the file, releases the claim, and closes the descriptor.
 // Writes are unbuffered appends, so the flush is the kernel's; Close is what
 // makes the file safe for another aforge to open. Calling it twice is safe.
diff --git a/internal/standing/store.go b/internal/standing/store.go
index 6fc450875..189c54863 100644
--- a/internal/standing/store.go
+++ b/internal/standing/store.go
@@ -617,10 +617,14 @@ func syncDir(dir string) error {
 		return nil
 	}
 	defer folder.Close()
-	_ = folder.Sync()
+	_ = syncFolder(folder)
 	return nil
 }
 
+// syncFolder is the seam the round-3b proof injects a failing sync through;
+// the old logic's behaviour is unchanged.
+var syncFolder = func(f *os.File) error { return f.Sync() }
+
 // newID is 16 random hex characters, the same shape and the same reasoning as a
 // session id: enough to name every item a machine will ever hold with nobody
 // coordinating.

