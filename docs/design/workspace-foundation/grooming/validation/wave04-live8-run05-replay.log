//go:build e2e

package session

import (
	"context"
	"os"
	"testing"

	"github.com/Agent-Field/agentfield/sdk/go/ai"

	"github.com/Agent-Field/aforge-v2/internal/provider"
	"github.com/Agent-Field/aforge-v2/internal/roles"
	"github.com/Agent-Field/aforge-v2/internal/standing"
)

// A throwaway replay of live8 run05's held check: the same rule, the same
// report, the same prompt, printing the checker's raw reply. Not committed.
func TestZZReplayRun05Check(t *testing.T) {
	key := os.Getenv("OPENROUTER_API_KEY")
	if key == "" {
		t.Skip("no key")
	}
	model := os.Getenv("AFORGE_RULES_CHECK_MODEL")
	raw, err := os.ReadFile("/tmp/opus-w4/run05-held-report.md")
	if err != nil {
		t.Fatal(err)
	}
	rules := []standing.Item{{ID: "500683211e22c8c1", Words: "Marketing review notes cite the spec line behind every finding and never edit the copy itself.", When: standing.When{Kind: standing.WhenHold}}}
	for attempt := 0; attempt < 2; attempt++ {
		client, err := provider.NewClient(provider.Config{APIKey: key, BaseURL: "https://openrouter.ai/api/v1", Model: model})
		if err != nil {
			t.Fatal(err)
		}
		agent, _ := newTestAgent(t, client, func(cfg *Config) { cfg.Model = model })
		response, _, err := agent.callRole(context.Background(), roles.RoleAuditor, model, []ai.Message{
			textMessage("system", standingRulesPrompt),
			textMessage("user", standingRulesQuestion(rules, string(raw))),
		})
		if err != nil {
			t.Fatal(err)
		}
		verdict := parseStandingRuleVerdict(response.Text(), string(raw), rules)
		t.Logf("REPLY %d: %s", attempt, response.Text())
		t.Logf("READ %d: answered=%v trouble=%q spend=$%.5f", attempt, verdict.answered, verdict.trouble, agent.Usage().CostUSD)
	}
}
