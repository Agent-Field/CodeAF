[178.9, "o", "\u001b[?25l\u001b[2J\u001b[H \u001b[38;5;252m>\u001b[38;5;179m\u25cf\u001b[39m \u001b[1m\u001b[38;5;110mcodeaf\u001b[0m  \u001b[38;5;110m home  teams \u001b[1m\u001b[38;5;146m chats \u001b[0m\u001b[38;5;110m sessions  spend  settings \u001b[39m                                                   \u001b[38;5;146m1 moving\u001b[39m \u00b7 \u001b[38;5;115m$0.38\u001b[39m \u00b7 \u001b[38;5;243msun 1:27pm\u001b[39m\r\n \u001b[38;5;243m \u001b[1m\u001b[38;5;237m\u001b[48;5;252m \u25d0 september reimbursement report handoff process \u00d7 \u001b[0m\u001b[38;5;243m  +   \u25a6\u001b[38;5;110m All \u001b[39m\r\n\u001b[38;5;243m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\r\n\u001b[39m  \u001b[38;5;252mNo \u2014 on exit 2 the old CSV is stale, not a fallback. Import only what this run wrote;\u001b[39m\r\n  \u001b[38;5;252mnever import on file presence alone.\u001b[39m\r\n\r\n  \u001b[1m\u001b[38;5;252mExit-code policy for \u001b[4m\u001b]8;;file:///tmp/codeaf-sustained-1607/final/reimbursement-project/run_report.sh\u001b\\run_report.sh\u001b[0m\u001b]8;;\u001b\\\r\n\r\n  \u001b[38;5;145mexit  meaning\u001b[39m                                                                           \u001b[38;5;145maction\u001b[39m\r\n  \u001b[38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\n  \u001b[38;5;252m0     report freshly written to TARGET\u001b[39m                                                  \u001b[38;5;252mimport TARGET\u001b[39m\r\n  \u001b[38;5;252m2     a row was skipped (--strict withheld the report) \u2192 TARGET left untouched = stale  do not import\u001b[39m\r\n  \u001b[38;5;252m1     hard error (missing file, missing column)\u001b[39m                                         \u001b[38;5;252mdo not import\u001b[39m\r\n  \u001b[38;5;252m64    bad script usage (missing args)\u001b[39m                                                   \u001b[38;5;252mdo not import\u001b[39m\r\n\r\n  \u001b[38;5;252mAny non-zero exit means TARGET is the \u001b[3mprevious\u001b[0m\u001b[38;5;252m file, so gate the import on the exit code\u001b[39m\r\n  \u001b[38;5;252m\u2014 that is what keeps stale and partial data out in one rule.\u001b[39m\r\n\r\n  \u001b[1m\u001b[38;5;252mCommand to use\u001b[0m\r\n                                                                                                                                           \u001b[38;5;252m\u276e\r\n\u001b[39m    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m \u001b[38;5;182mcd\u001b[38;5;255m \u001b[4m\u001b]8;;file:///tmp/codeaf-sustained-1607/final/reimbursement-project\u001b\\/tmp/codeaf-sustained-1607/final/reimbursement-project\u001b[0m\u001b[48;5;234m\u001b]8;;\u001b\\                                                                           \u001b[49m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m \u001b[4m\u001b]8;;file:///tmp/codeaf-sustained-1607/final/reimbursement-project/run_report.sh\u001b\\./run_report.sh\u001b[0m\u001b[38;5;255m\u001b[48;5;234m\u001b]8;;\u001b\\ TARGET.csv EXPORT.csv --month 2026-10 --category FOOD --csv --strict |\u001b[39m                                              \u001b[49m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m   { rc=${PIPESTATUS[0]\u001b[38;5;182m:-\u001b[38;5;255m${?}}; }\u001b[39m                                                                                                    \u001b[49m\r\n\r\n  \u001b[38;5;252mSimpler and reliable \u2014 separate the run from the import:\u001b[39m\r\n\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m \u001b[38;5;182mif\u001b[38;5;255m \u001b[4m\u001b]8;;file:///tmp/codeaf-sustained-1607/final/reimbursement-project/run_report.sh\u001b\\./run_report.sh\u001b[0m\u001b[38;5;255m\u001b[48;5;234m\u001b]8;;\u001b\\ TARGET.csv EXPORT.csv --month 2026-10 --category FOOD --csv --strict; \u001b[38;5;182mthen\u001b[39m                                       \u001b[49m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m     import TARGET.csv        \u001b[38;5;103m# only on exit 0: guaranteed fresh and complete for the month\u001b[39m                                          \u001b[49m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m \u001b[38;5;182melse\u001b[39m                                                                                                                                \u001b[49m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m     \u001b[38;5;182mecho\u001b[38;5;255m \u001b[38;5;151m\"skip import (exit \u001b[38;5;255m$?\u001b[38;5;151m), TARGET unchanged\"\u001b[38;5;255m >&\u001b[38;5;187m2\u001b[39m   