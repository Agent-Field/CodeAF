.github.com/repos/Agent-Field/CodeAF/commits{/sha}","git_commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/commits{/sha}","comments_url":"https://api.github.com/repos/Agent-Field/CodeAF/comments{/number}","issue_comment_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments{/number}","contents_url":"https://api.github.com/repos/Agent-Field/CodeAF/contents/{+path}","compare_url":"https://api.github.com/repos/Agent-Field/CodeAF/compare/{base}...{head}","merges_url":"https://api.github.com/repos/Agent-Field/CodeAF/merges","archive_url":"https://api.github.com/repos/Agent-Field/CodeAF/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/Agent-Field/CodeAF/downloads","issues_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues{/number}","pulls_url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls{/number}","milestones_url":"https://api.github.com/repos/Agent-Field/CodeAF/milestones{/number}","notifications_url":"https://api.github.com/repos/Agent-Field/CodeAF/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/Agent-Field/CodeAF/labels{/name}","releases_url":"https://api.github.com/repos/Agent-Field/CodeAF/releases{/id}","deployments_url":"https://api.github.com/repos/Agent-Field/CodeAF/deployments","created_at":"2026-08-05T16:00:07Z","updated_at":"2026-09-23T17:31:44Z","pushed_at":"2026-09-23T18:17:10Z","git_url":"git://github.com/Agent-Field/CodeAF.git","ssh_url":"git@github.com:Agent-Field/CodeAF.git","clone_url":"https://github.com/Agent-Field/CodeAF.git","svn_url":"https://github.com/Agent-Field/CodeAF","homepage":"http://agentfield.ai/","size":196153,"stargazers_count":116,"watchers_count":116,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":14,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":141,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["agent-fleet","agent-harness","agentfield","agentic-coding","ai","ai-coding","cli-agent","coding-agent","coding-agents","coding-assistant","coding-cli","coding-harness","developer-tools","harness","harness-engineering","llm","open-models","open-source-models","software-factory","terminal-agent"],"visibility":"public","forks":14,"open_issues":141,"watchers":116,"default_branch":"dev","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls/1373","html_url":"https://github.com/Agent-Field/CodeAF/pull/1373","diff_url":"https://github.com/Agent-Field/CodeAF/pull/1373.diff","patch_url":"https://github.com/Agent-Field/CodeAF/pull/1373.patch","merged_at":"2026-09-22T04:33:22Z"},"body":"Closes #1370.\n\n`TestNothingArrivingAfterTheStopIsDrawn` compares two whole rendered frames.\nThe head draws the time of day on every frame (`pulse.go`'s `pulseClock`, off\n`app.now`), so the wall clock was inside that comparison without anybody\nputting it there, and the test failed whenever its two captures straddled a\nminute boundary. Measured at one failure in eighty one runs.\n\n## The fix\n\n`stoppingApp` now builds its surface on a held clock, the way\n`stopbound_test.go`'s `boundedStopApp` already does. The seam existed:\n`app.now` reads `a.clock` and falls back to `time.Now`, so this is one\nassignment and no new mechanism.\n\nIT IS PINNED IN `stoppingApp` AND NOT IN `newTestApp`. `newTestApp` has calling\nfiles in the hundreds, and pinning the clock there changes the observable time\nfor every test in the package at once, including the ones asserting on elapsed\ndurations and relative words. That may be the better end state, but it is a\npackage-wide behaviour change and it is not this.\n\n## Red before green\n\nTwo reds, both on `89dacca80` with nothing else applied.\n\nThe shipped test, which is red at nanosecond resolution rather than at the\nminute boundary:\n\n```\n--- FAIL: TestTheStoppedSurfaceReadsAClockThatDoesNotMoveOnItsOwn\n    two readings of the stopped surface's clock differ by 64ns, so the head can\n    move between two frames nothing happened between\n```\n\nAnd the reported failure itself, made deterministic by pinning the clock 200ms\nbefore a minute boundary and walking it across during the test's own 0.45\nseconds. This ran on the base tree and is not part of the change:\n\n```\n--- FAIL: TestRedOnBaseTheReportedFlakeMadeDeterministic\n    the frame moved after the stop:\n    was:\n     codeaf                                          wed 3:43am\n    now:\n     codeaf                                          wed 3:44am\n```\n\nNothing else on the frame differs, which is the whole diff the gate saw.\n\n## The guard, which is on the fix and not on the product\n\nThere are two repairs here that produce the same green: pin the clock, or stop\ncomparing the part of the frame the clock is drawn in. The second one also\nstops the test noticing a real change to the head after a stop, which is inside\nwhat it exists to catch.\n\nSo the comparison now has a name, `stoppedFrame`, the test above uses it, and\n`TestTheStoppedFramesComparisonStillCoversTheHead` drives the held clock across\na minute boundary and insists the compared frame sees it.\n\nThat guard was checked by mutation rather than by assertion. Narrowing\n`stoppedFrame` to drop the head, which is exactly the cheap repair:\n\n```\n--- PASS: TestNothingArrivingAfterTheStopIsDrawn\n--- FAIL: TestTheStoppedFramesComparisonStillCoversTheHead\n    a minute passed and the compared frame did not move, so the head is no\n    longer inside the comparison\n```\n\nThe cheap repair leaves the original test green and this one red, which is the\nonly arrangement that makes it a guard.\n\n## Is anything else in the package exposed\n\nThe class is not \"a test that reads the clock\", it is a whole-frame string\ncomparison containing a field that moves on its own, so the search is for\nframes captured twice and compared rather than for `time.Now`. There are two\nsuch comparisons in `internal/tui3`:\n\n- `stopping_test.go`, this one.\n- `roomclick_test.go:132`, `TestAPressOnNothingInTheConversationDoesNothing`,\n  which compares `frame(a)` whole.\n\nThe second one is NOT exposed, and that is measured rather than reasoned: its\nframe does carry a clock word, and `roomApp` already holds its own clock\nthrough `taskApp`, so the field cannot move between its two captures. One site,\nfixed here, and no class issue owed.\n\n## Checks\n\nOn one box under its heavy-suite lock, `-count=1` unless stated.\n\n```\ngo test -count=200 -run '^TestNothingArrivingAfterTheStopIsDrawn$' ./internal/tui3/\ngo test -count=200 -run '^TestTheStoppedSurfaceReadsAClockThatDoesNotMoveOnItsOwn$|^TestTheStoppedFramesComparisonStillCoversTheHead$' ./internal/tui3/\ngo test -count=1 ./internal/tui3/\n```\n\n```\nok  github.com/Agent-Field/codeaf/internal/tui3   90.896s   (count=200, the reported test)\nok  github.com/Agent-Field/codeaf/internal/tui3  141.141s   (count=200, the two new ones)\nok  github.com/Agent-Field/codeaf/internal/tui3  325.673s   (count=1, the whole package)\n```\n\n`bash scripts/laws.sh` exits 0 across 27 packages. `gofmt -l ./cmd ./internal`\nprints nothing.\n\nThe whole package is in there because `stoppingApp` has seven callers across\ntwo files, and a helper that now pins a clock is a change to all of them.\n","reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1373/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1373/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":31697885159,"node_id":"LE_lADOTu5AHM8AAAABSeptbM8AAAAHYVdX5w","url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events/31697885159","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkumarradha/orgs","repos_url":"https://api.github.com/users/santoshkumarradha/repos","events_url":"https://api.github.com/users/santoshkumarradha/events{/privacy}","received_events_url":"https://api.github.com/users/santoshkumarradha/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2026-09-23T17:59:05Z","label":{"name":"bug","color":"1D76DB"},"intent":null,"performed_via_github_app":null},{"id":31697885238,"node_id":"LE_lADOTu5AHM8AAAABSeptbM8AAAAHYVdYNg","url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events/31697885238","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/fol