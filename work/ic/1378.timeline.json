y":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"repository":{"id":1324236828,"node_id":"R_kgDOTu5AHA","name":"CodeAF","full_name":"Agent-Field/CodeAF","private":false,"owner":{"login":"Agent-Field","id":204899035,"node_id":"O_kgDODDaC2w","avatar_url":"https://avatars.githubusercontent.com/u/204899035?v=4","gravatar_id":"","url":"https://api.github.com/users/Agent-Field","html_url":"https://github.com/Agent-Field","followers_url":"https://api.github.com/users/Agent-Field/followers","following_url":"https://api.github.com/users/Agent-Field/following{/other_user}","gists_url":"https://api.github.com/users/Agent-Field/gists{/gist_id}","starred_url":"https://api.github.com/users/Agent-Field/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Agent-Field/subscriptions","organizations_url":"https://api.github.com/users/Agent-Field/orgs","repos_url":"https://api.github.com/users/Agent-Field/repos","events_url":"https://api.github.com/users/Agent-Field/events{/privacy}","received_events_url":"https://api.github.com/users/Agent-Field/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/Agent-Field/CodeAF","description":"Open-Source Software factory for Open Models","fork":false,"url":"https://api.github.com/repos/Agent-Field/CodeAF","forks_url":"https://api.github.com/repos/Agent-Field/CodeAF/forks","keys_url":"https://api.github.com/repos/Agent-Field/CodeAF/keys{/key_id}","collaborators_url":"https://api.github.com/repos/Agent-Field/CodeAF/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/Agent-Field/CodeAF/teams","hooks_url":"https://api.github.com/repos/Agent-Field/CodeAF/hooks","issue_events_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events{/number}","events_url":"https://api.github.com/repos/Agent-Field/CodeAF/events","assignees_url":"https://api.github.com/repos/Agent-Field/CodeAF/assignees{/user}","branches_url":"https://api.github.com/repos/Agent-Field/CodeAF/branches{/branch}","tags_url":"https://api.github.com/repos/Agent-Field/CodeAF/tags","blobs_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/refs{/sha}","trees_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/trees{/sha}","statuses_url":"https://api.github.com/repos/Agent-Field/CodeAF/statuses/{sha}","languages_url":"https://api.github.com/repos/Agent-Field/CodeAF/languages","stargazers_url":"https://api.github.com/repos/Agent-Field/CodeAF/stargazers","contributors_url":"https://api.github.com/repos/Agent-Field/CodeAF/contributors","subscribers_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscribers","subscription_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscription","commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/commits{/sha}","git_commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/commits{/sha}","comments_url":"https://api.github.com/repos/Agent-Field/CodeAF/comments{/number}","issue_comment_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments{/number}","contents_url":"https://api.github.com/repos/Agent-Field/CodeAF/contents/{+path}","compare_url":"https://api.github.com/repos/Agent-Field/CodeAF/compare/{base}...{head}","merges_url":"https://api.github.com/repos/Agent-Field/CodeAF/merges","archive_url":"https://api.github.com/repos/Agent-Field/CodeAF/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/Agent-Field/CodeAF/downloads","issues_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues{/number}","pulls_url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls{/number}","milestones_url":"https://api.github.com/repos/Agent-Field/CodeAF/milestones{/number}","notifications_url":"https://api.github.com/repos/Agent-Field/CodeAF/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/Agent-Field/CodeAF/labels{/name}","releases_url":"https://api.github.com/repos/Agent-Field/CodeAF/releases{/id}","deployments_url":"https://api.github.com/repos/Agent-Field/CodeAF/deployments","created_at":"2026-08-05T16:00:07Z","updated_at":"2026-09-23T17:31:44Z","pushed_at":"2026-09-23T18:02:56Z","git_url":"git://github.com/Agent-Field/CodeAF.git","ssh_url":"git@github.com:Agent-Field/CodeAF.git","clone_url":"https://github.com/Agent-Field/CodeAF.git","svn_url":"https://github.com/Agent-Field/CodeAF","homepage":"http://agentfield.ai/","size":196153,"stargazers_count":116,"watchers_count":116,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":14,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":141,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["agent-fleet","agent-harness","agentfield","agentic-coding","ai","ai-coding","cli-agent","coding-agent","coding-agents","coding-assistant","coding-cli","coding-harness","developer-tools","harness","harness-engineering","llm","open-models","open-source-models","software-factory","terminal-agent"],"visibility":"public","forks":14,"open_issues":141,"watchers":116,"default_branch":"dev","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"body":"## What happened\n\nA person with eighty-one skills on disk asked the chat \"can you use skills ?\" and\nwas told:\n\n> If you meant skills in the Claude Code SKILL.md sense, codeaf has no such\n> mechanism — harnesses and the notebook are what it has instead.\n\nThe binary was built from the head that carries the skills wave and its manual\npages. The feature was there. The answer denies it exists.\n\n## Why\n\n`memory.enabled` was `off`.\n\n```\n~/.codeaf/config.json   memory.enabled = off\n~/.codeaf/graph.db      59.7 MB, facts table: 0 rows\n~/.claude/skills        40 direct-child SKILL.md\n~/.agents/skills        41 direct-child SKILL.md\n```\n\n`importForeignSkillsBeforeFirstMessage` (`cmd/codeaf/chatv3.go:1169`) returns on\nits first line when memory is nil. Nothing is recorded, so\n`renderSkillCatalog` (`internal/session/skillcatalog.go:64`) reads an empty\nshelf and emits zero bytes, and `useSkillTool` (`internal/session/tools_skill.go:71`)\nwithholds the verb. Every one of those is behaving as designed.\n\nThe model then has no shelf, no verb, and no sentence about either, so it\nreasons from the silence and invents a denial.\n\n## The two defects\n\n**One. Skills are gated on a setting that names something else, and nothing says\nso.** A person switches memory off to stop the program remembering things about\nthem. They also switch off skills, and are not told. That is one decision\nproducing two outcomes with only one of them disclosed.\n\n**Two. \"Absent because impossible here\" and \"absent because it does not exist\"\nare the same silence.** The absent-not-broken law works: it stops a model\nplanning a reply around a call that can only refuse. It does not stop the model\nreasoning from the silence and concluding the capability was never built. The\nlaw needs a companion clause rather than an exception: WHEN A CAPABILITY IS\nWITHHELD BY A SETTING, SOMETHING HAS TO SAY SO.\n\nThis is not the emptiness law's territory. That law is about a number nobody has\nyet: draw nothing rather than `$0.00`. It was never a licence to hide the\ndifference between \"you have no skills\" and \"skills are switched off here\".\n\n## Replication\n\n1. A profile with `memory.enabled = off` and any number of SKILL.md folders\n   under a scanned root.\n2. Ask the chat whether it can use skills.\n3. It denies the feature exists, rather than saying it is switched off.\n\n## Acceptance\n\nEnd to end, through the real surface, in BOTH states.\n\n- With memory off: the answer says skills are switched off on this machine and\n  names the setting. It does not say codeaf has no such mechanism.\n- With memory on: the shelf is there and the answer is yes.\n- The `/skill` picker with memory off says the same thing rather than drawing an\n  empty list.\n\nThen whatever mechanism carries it. One candidate: the catalog emits a single\nline when the store is absent and the roots are not, which costs a person with\nno skills nothing, because that person has no roots either.\n\n## Not in scope\n\n#1378 is the manual side: no heading answers the capability question in either\nstate. Fixing the sentence here does not fix retrieval there, and neither is a\nsubstitute for the other.\n","reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1379/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1379/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"},{"actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkum