rges_url":"https://api.github.com/repos/Agent-Field/CodeAF/merges","archive_url":"https://api.github.com/repos/Agent-Field/CodeAF/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/Agent-Field/CodeAF/downloads","issues_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues{/number}","pulls_url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls{/number}","milestones_url":"https://api.github.com/repos/Agent-Field/CodeAF/milestones{/number}","notifications_url":"https://api.github.com/repos/Agent-Field/CodeAF/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/Agent-Field/CodeAF/labels{/name}","releases_url":"https://api.github.com/repos/Agent-Field/CodeAF/releases{/id}","deployments_url":"https://api.github.com/repos/Agent-Field/CodeAF/deployments","created_at":"2026-08-05T16:00:07Z","updated_at":"2026-09-23T17:31:44Z","pushed_at":"2026-09-23T18:02:56Z","git_url":"git://github.com/Agent-Field/CodeAF.git","ssh_url":"git@github.com:Agent-Field/CodeAF.git","clone_url":"https://github.com/Agent-Field/CodeAF.git","svn_url":"https://github.com/Agent-Field/CodeAF","homepage":"http://agentfield.ai/","size":196153,"stargazers_count":116,"watchers_count":116,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":14,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":141,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["agent-fleet","agent-harness","agentfield","agentic-coding","ai","ai-coding","cli-agent","coding-agent","coding-agents","coding-assistant","coding-cli","coding-harness","developer-tools","harness","harness-engineering","llm","open-models","open-source-models","software-factory","terminal-agent"],"visibility":"public","forks":14,"open_issues":141,"watchers":116,"default_branch":"dev","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls/1031","html_url":"https://github.com/Agent-Field/CodeAF/pull/1031","diff_url":"https://github.com/Agent-Field/CodeAF/pull/1031.diff","patch_url":"https://github.com/Agent-Field/CodeAF/pull/1031.patch","merged_at":null},"body":"Fixes #1013.\n\nThe `something else…` row is a box — the one place on a question a person types\nan answer of their own — and `questionOtherKey` routed its keys by hand, binding\nonly a short list. So `cmd+←`/`cmd+→` never reached the ends of the line,\n`cmd+delete` never killed to the line's start, and `opt+delete`/`ctrl+delete`\nnever deleted a word: the chords worked in the message box under the answer and\nwere silently dead in the answer. It is the defect `editkeys.go` was written for,\nsaid about a box that had grown its own map.\n\n**Fix.** The motions now go through `editorMotion` and the word kill through\n`editorWordKill` — the one vocabulary every other box on the surface reads — and\nkill-to-start is read under the two names the message box already binds\n(`ctrl+u`, `super+backspace`). `ctrl+w` is deliberately still not the word kill\nhere: it shuts the tab in front everywhere on this surface, the same bargain the\nmessage box makes.\n\n- `internal/tui3/question.go` — replace the hand-rolled motion/word-kill cases\n  with the shared vocabulary; add the line kill.\n- `internal/tui3/questionchords_test.go` — the answer box takes the three word\n  names, the two line-end names, and both word kills. Red before the fix\n  (`ctrl+left was not taken…`, `ctrl+u did not kill…`), green after.\n- `internal/manual/chat/questions.md` — the box's paragraph now says what its\n  editing keys do (the manual law).\n- `docs/changes/unreleased/1013-question-answer-box-chords.md`.\n\n**Verified.** `go test ./internal/tui3/ -run Question` passes; `make test-quick`\n(build, vet, fmt, packed corpus, changelog, manual gates, laws — the whole tree)\nis green.\n\nDrafted with [agentfield ai](https://agentfield.ai/github?utm_source=github&utm_medium=pull_request&utm_campaign=drafted_with) · reviewed and owned by the author\n","reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1031/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1031/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkumarradha/orgs","repos_url":"https://api.github.com/users/santoshkumarradha/repos","events_url":"https://api.github.com/users/santoshkumarradha/events{/privacy}","received_events_url":"https://api.github.com/users/santoshkumarradha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-14T09:06:35Z","updated_at":"2026-09-14T09:06:35Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1032","repository_url":"https://api.github.co