":"https://avatars.githubusercontent.com/u/204899035?v=4","gravatar_id":"","url":"https://api.github.com/users/Agent-Field","html_url":"https://github.com/Agent-Field","followers_url":"https://api.github.com/users/Agent-Field/followers","following_url":"https://api.github.com/users/Agent-Field/following{/other_user}","gists_url":"https://api.github.com/users/Agent-Field/gists{/gist_id}","starred_url":"https://api.github.com/users/Agent-Field/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Agent-Field/subscriptions","organizations_url":"https://api.github.com/users/Agent-Field/orgs","repos_url":"https://api.github.com/users/Agent-Field/repos","events_url":"https://api.github.com/users/Agent-Field/events{/privacy}","received_events_url":"https://api.github.com/users/Agent-Field/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/Agent-Field/CodeAF","description":"Open-Source Software factory for Open Models","fork":false,"url":"https://api.github.com/repos/Agent-Field/CodeAF","forks_url":"https://api.github.com/repos/Agent-Field/CodeAF/forks","keys_url":"https://api.github.com/repos/Agent-Field/CodeAF/keys{/key_id}","collaborators_url":"https://api.github.com/repos/Agent-Field/CodeAF/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/Agent-Field/CodeAF/teams","hooks_url":"https://api.github.com/repos/Agent-Field/CodeAF/hooks","issue_events_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events{/number}","events_url":"https://api.github.com/repos/Agent-Field/CodeAF/events","assignees_url":"https://api.github.com/repos/Agent-Field/CodeAF/assignees{/user}","branches_url":"https://api.github.com/repos/Agent-Field/CodeAF/branches{/branch}","tags_url":"https://api.github.com/repos/Agent-Field/CodeAF/tags","blobs_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/refs{/sha}","trees_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/trees{/sha}","statuses_url":"https://api.github.com/repos/Agent-Field/CodeAF/statuses/{sha}","languages_url":"https://api.github.com/repos/Agent-Field/CodeAF/languages","stargazers_url":"https://api.github.com/repos/Agent-Field/CodeAF/stargazers","contributors_url":"https://api.github.com/repos/Agent-Field/CodeAF/contributors","subscribers_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscribers","subscription_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscription","commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/commits{/sha}","git_commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/commits{/sha}","comments_url":"https://api.github.com/repos/Agent-Field/CodeAF/comments{/number}","issue_comment_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments{/number}","contents_url":"https://api.github.com/repos/Agent-Field/CodeAF/contents/{+path}","compare_url":"https://api.github.com/repos/Agent-Field/CodeAF/compare/{base}...{head}","merges_url":"https://api.github.com/repos/Agent-Field/CodeAF/merges","archive_url":"https://api.github.com/repos/Agent-Field/CodeAF/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/Agent-Field/CodeAF/downloads","issues_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues{/number}","pulls_url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls{/number}","milestones_url":"https://api.github.com/repos/Agent-Field/CodeAF/milestones{/number}","notifications_url":"https://api.github.com/repos/Agent-Field/CodeAF/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/Agent-Field/CodeAF/labels{/name}","releases_url":"https://api.github.com/repos/Agent-Field/CodeAF/releases{/id}","deployments_url":"https://api.github.com/repos/Agent-Field/CodeAF/deployments","created_at":"2026-08-05T16:00:07Z","updated_at":"2026-09-23T17:31:44Z","pushed_at":"2026-09-23T18:02:56Z","git_url":"git://github.com/Agent-Field/CodeAF.git","ssh_url":"git@github.com:Agent-Field/CodeAF.git","clone_url":"https://github.com/Agent-Field/CodeAF.git","svn_url":"https://github.com/Agent-Field/CodeAF","homepage":"http://agentfield.ai/","size":196153,"stargazers_count":116,"watchers_count":116,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":14,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":141,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["agent-fleet","agent-harness","agentfield","agentic-coding","ai","ai-coding","cli-agent","coding-agent","coding-agents","coding-assistant","coding-cli","coding-harness","developer-tools","harness","harness-engineering","llm","open-models","open-source-models","software-factory","terminal-agent"],"visibility":"public","forks":14,"open_issues":141,"watchers":116,"default_branch":"dev","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"body":"The one-suite rule binds `make`, not the box. `scripts/one-suite.sh` opens with\nthe reason the lock exists: nine sessions fired `go test ./...` at once, the\nreds that came out were manufactured by the load, and so \"a second run on the\nsame box refuses to start and says who holds it rather than joining the pile.\"\n\nA second run started as `go test ./internal/session` does not refuse. It does\nnot see the lock, does not take one, and nothing tells it to. It is the same\nworkload the lock exists to serialise, entered by a door that has no lock on it.\n\n## Observed on the box, 2026-09-20T19:25Z\n\nTwo heavy runs alive at the same instant, one holding the lock and one not.\n\nThe holder, correct in every respect:\n\n- pid 1555853, `bin/codeaf-suite-lock --hold-heavy-suite-lock 1555852 302442410`,\n  cwd `/home/santosh/src/trees/sdev-e098ca1fd`, holding fd 3 on\n  `/tmp/codeaf-suite-1001.lockfile`.\n- Its parent chain is `bash /tmp/gate.sh e098ca1fd` then `make check` then\n  `codeaf-suite-lock /tmp/codeaf-suite-1001.lockfile go test -count=1 -timeout 15m`.\n  It went through the Makefile, so it took the lock.\n\nBeside it, taking nothing:\n\n- pid 1531326, `go test ./internal/session`, started 19:21:29Z, 4m20s elapsed at\n  the time of reading, a direct child of an ordinary shell.\n- It started about forty seconds BEFORE the gate took the lock, so the gate did\n  not refuse either: there was nothing to refuse against.\n\nBox load reached 14.52 with both up.\n\n## This is not #1307\n\n#1307 is two lock mechanisms that cannot see each other, both of which are\ntrying to participate. This is a runner that never enters the scheme at all. It\nis not failing to cooperate, it has no cooperation to fail at.\n\nThe distinction decides what a fix is worth. Every remedy in #1307, dual\nchecking on the read side and taking both locks in `one-suite.sh`, could land\ntomorrow and this hole would be exactly as open as it is now. A reader of #1307\nalone would reasonably conclude the flock closed it.\n\nPut plainly: the lock does not protect the box from every heavy run, only from\nthe ones that went through `make`. A lock that binds only the compliant is a\nconvention with a syscall in it.\n\n## The mechanism, from the repo's own files\n\n`Makefile:125-126`\n\n```make\nHEAVY_PKGS := ./... ./internal/tui3 ./internal/tui3/ ./internal/session ./internal/session/\nSUITE_LOCK := $(if $(filter $(HEAVY_PKGS),$(PKGS)),./scripts/one-suite.sh)\n```\n\nThe lock is selected by the PKGS variable of the `test` target. `scripts/one-suite.sh`\nsays the same thing in prose: \"The Makefile invokes this wrapper for a full\n`make test` or `test-report` when PKGS contains `./...`, `./internal/tui3` or\n`./internal/session`.\"\n\nSo the binding is between the MAKE TARGET and the lock. It is not between the\nPACKAGE and the lock, and the package is what actually loads the box.\n\nNote that the Makefile already takes the neighbouring risk seriously one level\nup. `test-focus` requires `RUN` and refuses without it, with the comment \"an\nomitted selector must not silently turn a focused command into a full package\nrun.\" That guards a focused run degrading into a heavy one inside `make`. It\ncannot guard a heavy run that never enters `make`.\n\n## Refusing is the wrong answer for an unattended runner\n\n`cmd/codeaf-suite-lock` refuses a contender and prints \"Wait for it, or run one\nnamed regression with make test-focus.\" For a person at a terminal that is\nright: they read it and retry.\n\nFor an unattended runner it converts a scheduling fact into a false negative\nabout the work. A run that fails because the box was busy is indistinguishable,\nin whatever report it writes, from a run that failed because the code is wrong.\nThat is the shape this repository keeps finding in other places: a single signal\nthat means two different things.\n\nSo whatever closes this should make an unattended contender WAIT, with its own\ntimeout, and record how long it waited in its report. Never proceed unlocked,\nand never fail for contention.\n\n## What I am not claiming\n\nI have not shown that the overlap above corrupted any result. Both runs may\nfinish clean. The claim is only that the box permitted two heavy suites at once\nwhile one of them believed it held exclusivity, which is the state the lock was\nwritten to make impossible.\n\nRelated: #1307.\n","reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1320/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1320/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments/5752090231","html_url":"https://github.com/Agent-Field/CodeAF/issues/1307#issuecomment-5752090231","issue_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1307","id":5752090231,"node_id":"IC_kwDOTu5AHM8AAAABVtnudw","user":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkumarradha/orgs","repos_url":"https://api.github.com/users/santoshkumarradha/repos","events_url":"https://api.github.com/users/santoshkumarradha/events{/privacy}","received_events_url":"https://api.github.com/users/santoshkumarradha/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-20T19:26:29Z","updated_at":"2026-09-20T19:26:29Z","body":"Filed #1320 for a hole that none of the remedies here close, and recording the boundary so a reader of this issue does not over-credit its fix.\n\nThis issue is two lock mechanisms that cannot see each other, both of which are trying to participate. #1320 is a runner that never enters the scheme: `go test ./internal/session` typed directly. The binding in `Makefile:126` is between the make TARGET and the lock, not between the PACKAGE and the lock, and the package is what loads the box.\n\nSo dual checking on the read side, and taking both locks in `scripts/one-suite.sh`, could both land tomorrow and #1320 would be exactly as open. Observed live on 2026-09-20T19:25Z: a correct holder through `make check` and an unlocked `go test ./internal/session` alive at the same instant, box load 14.52.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments/5752090231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkumarradha/orgs","repos_url":"https://api.github.com/users/santoshkumarradha/repos","events_url":"https://api.github.com/users/santoshkumarradha/events{/privacy}","received_events_url":"https://api.github.com/users/santoshkumarradha/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"ht