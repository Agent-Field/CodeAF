://github.com/Agent-Field/CodeAF","description":"Open-Source Software factory for Open Models","fork":false,"url":"https://api.github.com/repos/Agent-Field/CodeAF","forks_url":"https://api.github.com/repos/Agent-Field/CodeAF/forks","keys_url":"https://api.github.com/repos/Agent-Field/CodeAF/keys{/key_id}","collaborators_url":"https://api.github.com/repos/Agent-Field/CodeAF/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/Agent-Field/CodeAF/teams","hooks_url":"https://api.github.com/repos/Agent-Field/CodeAF/hooks","issue_events_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events{/number}","events_url":"https://api.github.com/repos/Agent-Field/CodeAF/events","assignees_url":"https://api.github.com/repos/Agent-Field/CodeAF/assignees{/user}","branches_url":"https://api.github.com/repos/Agent-Field/CodeAF/branches{/branch}","tags_url":"https://api.github.com/repos/Agent-Field/CodeAF/tags","blobs_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/refs{/sha}","trees_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/trees{/sha}","statuses_url":"https://api.github.com/repos/Agent-Field/CodeAF/statuses/{sha}","languages_url":"https://api.github.com/repos/Agent-Field/CodeAF/languages","stargazers_url":"https://api.github.com/repos/Agent-Field/CodeAF/stargazers","contributors_url":"https://api.github.com/repos/Agent-Field/CodeAF/contributors","subscribers_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscribers","subscription_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscription","commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/commits{/sha}","git_commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/commits{/sha}","comments_url":"https://api.github.com/repos/Agent-Field/CodeAF/comments{/number}","issue_comment_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments{/number}","contents_url":"https://api.github.com/repos/Agent-Field/CodeAF/contents/{+path}","compare_url":"https://api.github.com/repos/Agent-Field/CodeAF/compare/{base}...{head}","merges_url":"https://api.github.com/repos/Agent-Field/CodeAF/merges","archive_url":"https://api.github.com/repos/Agent-Field/CodeAF/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/Agent-Field/CodeAF/downloads","issues_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues{/number}","pulls_url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls{/number}","milestones_url":"https://api.github.com/repos/Agent-Field/CodeAF/milestones{/number}","notifications_url":"https://api.github.com/repos/Agent-Field/CodeAF/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/Agent-Field/CodeAF/labels{/name}","releases_url":"https://api.github.com/repos/Agent-Field/CodeAF/releases{/id}","deployments_url":"https://api.github.com/repos/Agent-Field/CodeAF/deployments","created_at":"2026-08-05T16:00:07Z","updated_at":"2026-09-23T17:31:44Z","pushed_at":"2026-09-23T18:02:56Z","git_url":"git://github.com/Agent-Field/CodeAF.git","ssh_url":"git@github.com:Agent-Field/CodeAF.git","clone_url":"https://github.com/Agent-Field/CodeAF.git","svn_url":"https://github.com/Agent-Field/CodeAF","homepage":"http://agentfield.ai/","size":196153,"stargazers_count":116,"watchers_count":116,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":14,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":141,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["agent-fleet","agent-harness","agentfield","agentic-coding","ai","ai-coding","cli-agent","coding-agent","coding-agents","coding-assistant","coding-cli","coding-harness","developer-tools","harness","harness-engineering","llm","open-models","open-source-models","software-factory","terminal-agent"],"visibility":"public","forks":14,"open_issues":141,"watchers":116,"default_branch":"dev","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls/1324","html_url":"https://github.com/Agent-Field/CodeAF/pull/1324","diff_url":"https://github.com/Agent-Field/CodeAF/pull/1324.diff","patch_url":"https://github.com/Agent-Field/CodeAF/pull/1324.patch","merged_at":null},"body":"The heavy-suite lock is two mechanisms that cannot see each other, so its\nexclusivity is a claim the box does not honour (#1307). A checkout at or past\n#1264 takes an flock on `/tmp/codeaf-suite-<uid>.lockfile`. A checkout behind it\ntakes the older directory lock at `/tmp/codeaf-suite-<uid>.lock`. Two heavy\nsuites run side by side and each believes it has the box to itself.\n\nDual-checking on the READ side closes one direction only. It stops us starting\nbeside a stale holder; it cannot stop a stale runner starting beside us, because\nnever having heard of the flock is precisely what makes it stale, and it will\nnever be taught to read one. Taking BOTH locks closes the other direction\nwithout changing a single old checkout: a current tree becomes visible to every\nstale reader still out there, and the remaining blindness runs in the safe\ndirection only.\n\n## Three decisions, each of which could have gone the other way\n\n**The directory is CLAIMED first and the refusal is REPORTED last.** The claim\ncomes first so there is no window in which a current tree holds the flock and is\nstill invisible to a stale runner. The refusal is deferred until the flock has\nhad its say because the two collisions are not equally well understood: two\nCURRENT trees collide on the flock, and that refusal knows whether the recorded\npid is visible from this pid namespace and what to run when it is not. Reporting\nthe directory first replaced that diagnosis with a cruder one for the common\ncase in order to describe a rarer one. The first draft did exactly that and the\nexisting acceptance arms caught it.\n\n**The directory is freed by whoever holds the flock, which is the HOLDER beside\nthe suite and not this wrapper.** The flock's lifetime is deliberately the\nholder's, and killing the wrapper is explicitly permitted: it must not unlock a\nbox that is still running a suite. A directory lock released on the wrapper's\nschedule would open the box to a stale reader while the flock was still held,\nwhich is the two readers of one state disagreeing, again. The holder inherits\nthe environment, so it knows the lock by the same name and drops it when the\nsuite ends.\n\n**The two paths are named independently in the configuration.** Deriving one by\ntrimming `file` off the other would make two names one fact, and a fact spelled\ntwice can disagree with itself. It would also follow a test harness driving a\nprivate lock straight to the real one, silently. An empty setting means no\ndirectory lock at all, which is what a platform that never had one wants.\n\n## The test, and the arm that matters\n\n`scripts/one-suite_test.sh` gains two functions and every existing arm is pinned\nto a private directory lock, without which the suite would have taken the real\none on whatever box it ran on.\n\n- `run_both_locks`. A held suite is visible to a reader of the DIRECTORY\n  mechanism, which is the only road a stale checkout has; it is still visible to\n  a reader of the FLOCK, unchanged; and RELEASE DROPS BOTH.\n- `run_refused_by_directory`. A stale holder turns a current run away, which is\n  the direction that has been costing unattributable reds. It also asserts that\n  a refused run leaves the lock exactly where it found it, since it never held\n  it.\n\nThe release assertion is the one that matters and the one that was awkward to\nconstruct. A half release leaves the box locked to one of the two populations\nforever, which is worse than the defect being fixed, because the defect at least\nfails open.\n\n### Both new arms were shown to fail, by mutation\n\nNot asserted, run. Each mutation was applied, the arms run against it, and the\ncode restored:\n\n| mutation | what the arm said |\n| --- | --- |\n| the holder no longer drops the directory lock | `the directory lock /tmp/.../both.lock.dir outlived the suite that took it` |\n| `takeDirLock` reports success without creating anything | `a held suite did not take the directory lock /tmp/.../both.lock.dir` |\n\nUnmutated, the same run prints `one-suite namespace and dual-lock acceptance: ok`.\n\n## One defect found and fixed on the way\n\nThe first draft wrote the directory's `pid` file between the suite starting and\nthe flock being named. The existing arms read the lock file as soon as the suite\nreports it is up, so that extra write widened a pre-existing window and they\nbegan reading an empty lock. The pid file is now written after the flock is\nnamed, and the arm that reads it waits for it rather than reading once and\ncalling an empty file a defect.\n\n## Checks\n\n`bash scripts/one-suite_test.sh` passes, five arms.\n`go test ./cmd/codeaf-suite-lock ./internal/guard ./internal/namelaw` all ok.\n`go vet ./cmd/codeaf-suite-lock` clean, `gofmt -l ./cmd ./internal` empty.\n`GOOS=windows go build ./cmd/codeaf-suite-lock` builds: that platform has no\nholder, so the wrapper keeps the directory lock and frees it itself.\n\nWritten against `9b38c2dda`.\n\nRefs #1307.\n","reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1324/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1324/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":31493580048,"node_id":"REFE_lADOTu5AHM8AAAABSQAAFs8AAAAHVSnlEA","url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events/31493580048","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkumarradha/orgs","repos_url":"https://api.github.com/users/santoshkumarradha/repos","events_url":"https://api.github.com/users/santoshkumarradha/events{/privacy}","received_events_url":"https://api.github.com/users/santoshkumarradha/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"380309d0baf0587002f1278c521e70e5b9b52b5e","commit_url":"https://api.github.com/repos/Agent-Field/CodeAF/commits/380309d0baf0587002f1278c521e70e5b9b52b5e","created_at":"2026-09-20T21:36:45Z","performed_via_github_app":null},{"id":31500783271,"node_id":"LE_lADOTu5AHM8AAAABSQAAFs8AAAAHVZfOpw","url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events/31500783271","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkuma