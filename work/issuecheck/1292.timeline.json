s_url":"https://api.github.com/repos/Agent-Field/CodeAF/statuses/{sha}","languages_url":"https://api.github.com/repos/Agent-Field/CodeAF/languages","stargazers_url":"https://api.github.com/repos/Agent-Field/CodeAF/stargazers","contributors_url":"https://api.github.com/repos/Agent-Field/CodeAF/contributors","subscribers_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscribers","subscription_url":"https://api.github.com/repos/Agent-Field/CodeAF/subscription","commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/commits{/sha}","git_commits_url":"https://api.github.com/repos/Agent-Field/CodeAF/git/commits{/sha}","comments_url":"https://api.github.com/repos/Agent-Field/CodeAF/comments{/number}","issue_comment_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/comments{/number}","contents_url":"https://api.github.com/repos/Agent-Field/CodeAF/contents/{+path}","compare_url":"https://api.github.com/repos/Agent-Field/CodeAF/compare/{base}...{head}","merges_url":"https://api.github.com/repos/Agent-Field/CodeAF/merges","archive_url":"https://api.github.com/repos/Agent-Field/CodeAF/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/Agent-Field/CodeAF/downloads","issues_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues{/number}","pulls_url":"https://api.github.com/repos/Agent-Field/CodeAF/pulls{/number}","milestones_url":"https://api.github.com/repos/Agent-Field/CodeAF/milestones{/number}","notifications_url":"https://api.github.com/repos/Agent-Field/CodeAF/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/Agent-Field/CodeAF/labels{/name}","releases_url":"https://api.github.com/repos/Agent-Field/CodeAF/releases{/id}","deployments_url":"https://api.github.com/repos/Agent-Field/CodeAF/deployments","created_at":"2026-08-05T16:00:07Z","updated_at":"2026-09-23T17:31:44Z","pushed_at":"2026-09-23T18:02:56Z","git_url":"git://github.com/Agent-Field/CodeAF.git","ssh_url":"git@github.com:Agent-Field/CodeAF.git","clone_url":"https://github.com/Agent-Field/CodeAF.git","svn_url":"https://github.com/Agent-Field/CodeAF","homepage":"http://agentfield.ai/","size":196153,"stargazers_count":116,"watchers_count":116,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":14,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":141,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["agent-fleet","agent-harness","agentfield","agentic-coding","ai","ai-coding","cli-agent","coding-agent","coding-agents","coding-assistant","coding-cli","coding-harness","developer-tools","harness","harness-engineering","llm","open-models","open-source-models","software-factory","terminal-agent"],"visibility":"public","forks":14,"open_issues":141,"watchers":116,"default_branch":"dev","permissions":{"admin":true,"maintain":true,"push":true,"triage":true,"pull":true}},"body":"Grooming. No work proposed yet.\n\nWe ask people a lot of different questions and present nearly all of them the same way. [Toward a Theory of Human-Agent Experience](https://www.santoshkumarradha.com/writing/toward-theory-hax) gives a vocabulary for why that is wrong, and we should use it.\n\n## The framework, in one paragraph\n\nThree independent dimensions: **delegation depth** (co-creation through full autonomy), **consequentiality weighted by reversibility** (what an error costs and how easily it is undone), and **commitment horizon** (one exchange, a bounded project, or an open-ended relationship). Its central claim is that consequentiality suppresses delegation regardless of capability: people stay hands-on because errors are expensive, not because the system is weak.\n\n## Why it applies here\n\nEvery question we ask sits somewhere different on those three axes, and today almost none of that shows in how it is drawn.\n\n| What we ask | Delegation | Consequence, reversibility | Horizon |\n| --- | --- | --- | --- |\n| approval for a tool call | low | varies enormously, mostly reversible | this turn |\n| the model's own `ask` | low | usually low | this turn |\n| `your call` on a landing | high | reversible, branch kept | this run |\n| a watch proposing itself | high | low each firing, recurring | open-ended |\n| a sub-harness offer | medium | bounded | this turn |\n| sign-in | none | low | open-ended |\n| the fuel gate | high | spends money | this run |\n\nSome of these are one keystroke in a lifetime. Some recur every ten minutes forever. One of them spends money. They currently share a mark, a tier and roughly one shape.\n\n## What to work out\n\n- Which axis should drive **loudness**. The piece suggests consequentiality rather than delegation depth, which would be a change: today a recurring low-stakes watch card and an irreversible action can draw the same amber.\n- Which axis should drive **whether a question blocks**. A long horizon probably argues for asking once and remembering, rather than asking every time.\n- Whether reversibility belongs in the question itself. \"This can be undone\" and \"this cannot\" may matter more than what the call is.\n- Whether the eight regions give us a small set of question shapes, or whether the three axes are better used as a checklist when adding a new one.\n- Where our existing surfaces already encode one of these accidentally, so we keep what is right rather than rebuilding it.\n\n## Related\n\n- #1292, terminal glyph rendering, which decides what shapes we can actually draw.\n- The needs-you audit: several states currently carry an attention mark with nothing to answer, which is a consequentiality question wearing a delegation mark.\n","reactions":{"url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1294/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/1294/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":31500780568,"node_id":"LE_lADOTu5AHM8AAAABSPbPqc8AAAAHVZfEGA","url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events/31500780568","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercontent.com/u/29346072?v=4","gravatar_id":"","url":"https://api.github.com/users/santoshkumarradha","html_url":"https://github.com/santoshkumarradha","followers_url":"https://api.github.com/users/santoshkumarradha/followers","following_url":"https://api.github.com/users/santoshkumarradha/following{/other_user}","gists_url":"https://api.github.com/users/santoshkumarradha/gists{/gist_id}","starred_url":"https://api.github.com/users/santoshkumarradha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/santoshkumarradha/subscriptions","organizations_url":"https://api.github.com/users/santoshkumarradha/orgs","repos_url":"https://api.github.com/users/santoshkumarradha/repos","events_url":"https://api.github.com/users/santoshkumarradha/events{/privacy}","received_events_url":"https://api.github.com/users/santoshkumarradha/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2026-09-21T02:34:31Z","label":{"name":"bug","color":"1D76DB"},"intent":null,"performed_via_github_app":null},{"id":31500780596,"node_id":"LE_lADOTu5AHM8AAAABSPbPqc8AAAAHVZfENA","url":"https://api.github.com/repos/Agent-Field/CodeAF/issues/events/31500780596","actor":{"login":"santoshkumarradha","id":29346072,"node_id":"MDQ6VXNlcjI5MzQ2MDcy","avatar_url":"https://avatars.githubusercon