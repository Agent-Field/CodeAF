;5;255m\u001b[48;5;234m $ python3 \u001b[4m\u001b]8;;file:///tmp/caf-extended-1608/project/pantry.py\u001b\\pantry.py\u001b[0m\u001b[38;5;255m\u001b[48;5;234m\u001b]8;;\u001b\\ \u001b[4m\u001b]8;;file:///tmp/caf-extended-1608/project/pantry.csv\u001b\\pantry.csv\u001b[0m\u001b[38;5;255m\u001b[48;5;234m\u001b]8;;\u001b\\ --json\u001b[39m                                                              \u001b[38;5;243m\u001b[49m\u2502 \u001b[39m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m [{\"item\": \"beans\", \"quantity\": 0, \"buy\": 3}, {\"item\": \"rice\", \"quantity\": 2, \"buy\": 1}]            \u001b[38;5;243m\u001b[49m\u2502 \u001b[39m\r\n                                                                                                         \u001b[38;5;243m\u2502 \u001b[39m\r\n  \u001b[38;5;252mDefault text output (no args) reads \u001b[4m\u001b]8;;file:///tmp/caf-extended-1608/project/pantry.csv\u001b\\pantry.csv\u001b[0m\u001b[38;5;252m\u001b]8;;\u001b\\ and prints the same \u001b[48;5;234mbeans: 3\u001b[49m / \u001b[48;5;234mrice: 1\u001b[49m.\u001b[39m                 \u001b[38;5;243m\u2502 \u001b[39m\r\n                                                                                                         \u001b[38;5;243m\u2502 \u001b[39m\r\n  \u001b[38;5;252mFractional check \u2014 a temporary CSV with \u001b[48;5;234moats,1.5\u001b[49m and \u001b[48;5;234m--threshold 3\u001b[49m:\u001b[39m                                    \u001b[38;5;243m\u2502 \u001b[39m\r\n                                                                                                         \u001b[38;5;243m\u2502 \u001b[39m\r\n    \u001b[38;5;102m\u258f\u001b[38;5;255m\u001b[48;5;234m $ python3 \u001b[4m\u001b]8;;file:///tmp/caf-extended-1608/project/pantry.py\u001b\\pantry.py\u001b[0m\u001b[38;5;255m\u001b[48;5;234m\u001b]8;;\u001b\\ frac.csv --threshold 3\u001b[39m                                                         \u001b[38;5;243m\u001b[49m\u2502 \u001b[39