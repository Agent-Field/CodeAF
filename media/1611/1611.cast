b[m\r\n\u001b[38;5;243m│\u001b[m \u001b[38;5;243mSay a different time or place. Nothing is set up yet.\u001b[m\u001b[84X\u001b[84C\u001b[38;5;243m│\u001b[m\r\n\u001b[38;5;243m│\u001b[m\u001b[138X\u001b[140G\u001b[38;5;243m│\u001b[m\r\n\u001b[38;5;243m│\u001b[m \u001b[38;5;243m› \u001b[m\u001b[135X\u001b[140G\u001b[38;5;243m│\u001b[m\r\n\u001b[38;5;243m│\u001b[m\u001b[138X\u001b[140G\u001b[38;5;243m│\u001b[m\r\n\u001b[38;5;243m│\u001b[m\u001b[138X\u001b[140G\u001b[38;5;243m│\u001b[m\r\n\u001b[38;5;243m╰─\u001b[m \u001b[38;5;116mesc\u001b[38;5;243m later · \u001b[38;5;116mo\u001b[38;5;243m Change… · \u001b[38;5;116m?\u001b[38;5;243m clarify\u001b[m \u001b[38;5;243m──────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[?7l╯\u001b[?7h\u001b[m\u001b[39;5H\u001b[?25h"]
