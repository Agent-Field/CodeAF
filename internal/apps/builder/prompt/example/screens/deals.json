{
  "screen": "deals",
  "title": "Deals",
  "nav": { "part": "SectionTabs", "label": "Partnerships sections", "props": { "items": ["Deals", "Companies"] } },
  "body": {
    "part": "Row",
    "children": [
      {
        "part": "Stack",
        "children": [
          {
            "part": "Row",
            "children": [
              { "part": "Text", "props": { "text": "Deals", "size": "title" } },
              {
                "part": "Button", "label": "New deal", "props": { "kind": "primary" },
                "on": { "click": [{ "records.create": { "type": "deal", "set": { "name": "$input.name", "value": "$input.value", "stage": "Idea" } }, "ask": { "name": "text", "value": "money" } }] }
              }
            ]
          },
          {
            "part": "RecordList", "id": "deals", "label": "Deals",
            "bind": { "records": "deal", "query": "stage:-Dropped sort:last_touch" },
            "props": { "views": ["Board by Stage", "List"], "meter": "stage", "groupBy": "stage", "query": true, "columns": ["name", "company", "stage", "value", "due_on", "last_touch"] },
            "slots": { "empty": { "part": "Empty", "props": { "text": "No deals yet. Add the first one." } } },
            "children": [
              { "part": "ScreenSubtitle", "props": { "noun": "open deals", "phrase": "quietest first" } },
              { "part": "StatStrip", "bind": { "records": "deal" }, "props": { "field": "stage" } },
              { "part": "FilterTokens", "label": "Filter deals", "props": { "labels": ["stage:Talking", "owner:me"], "placeholder": "Search deals" } }
            ]
          },
          {
            "part": "BulkBar", "when": "$selection.deals.count > 0", "props": { "list": "deals" },
            "children": [
              { "part": "Button", "label": "Draft nudge", "on": { "click": [{ "runs.start": "follow-up", "params": { "deals": "$selection.deals.ids" } }] } }
            ]
          }
        ]
      },
      {
        "part": "Panel", "label": "Selected deal", "when": "$selection.deals.count == 1",
        "children": [
          { "part": "RecordPage", "label": "Deal", "bind": { "record": "$selection.deals.id", "type": "deal" }, "props": { "fields": ["name", "company", "stage", "value", "due_on", "owner", "last_touch", "notes"], "actions": ["nudge"] } },
          {
            "part": "Form", "label": "Edit deal", "bind": { "record": "$selection.deals.id", "type": "deal" },
            "props": { "type": "deal", "fields": ["name", "company", "stage", "value", "due_on", "owner", "notes"], "submit": "Save" },
            "on": { "submit": [{ "records.update": { "id": "$selection.deals.id", "set": { "name": "$input.name", "company": "$input.company", "stage": "$input.stage", "value": "$input.value", "due_on": "$input.due_on", "owner": "$input.owner", "notes": "$input.notes" } } }] }
          },
          { "part": "Button", "label": "Delete deal…", "props": { "kind": "destructive" }, "on": { "click": [{ "records.delete": { "id": "$selection.deals.id" }, "confirm": "Delete this deal?" }] } }
        ]
      }
    ]
  }
}
