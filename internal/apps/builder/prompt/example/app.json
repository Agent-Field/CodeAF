{
  "id": "partnerships",
  "name": "Partnerships",
  "description": "Companies we talk to and the deals with each, from first idea to signed. The agent drafts nudges; every email waits for approval.",
  "space": "personal",
  "version": 1,
  "kit": 2,
  "agent": { "name": "Partnerships agent", "file": "agent.md", "model": "deepseek/deepseek-v4.1-flash" },
  "records": {
    "company": {
      "label": "Company", "plural": "Companies", "title": "name",
      "fields": {
        "name": { "type": "text", "label": "Company", "required": true, "unique": true },
        "website": { "label": "Website", "type": "url" },
        "kind": { "label": "Partner type", "type": "enum", "values": ["Reseller", "Integrator", "Media", "Other"] },
        "owner": { "label": "Owner", "type": "person", "default": "$me" },
        "notes": { "label": "Notes", "type": "longtext" }
      }
    },
    "deal": {
      "label": "Deal", "plural": "Deals", "title": "name",
      "fields": {
        "name": { "type": "text", "label": "Deal", "required": true },
        "company": { "label": "Company", "type": "ref", "to": "company", "index": true },
        "stage": { "label": "Stage", "type": "enum", "default": "Idea", "index": true, "values": ["Idea", "Talking", "Terms", "Signed", "Dropped"] },
        "value": { "label": "Deal value", "type": "money", "currency": "USD" },
        "due_on": { "label": "Due date", "type": "date" },
        "owner": { "label": "Owner", "type": "person", "default": "$me" },
        "last_touch": { "label": "Last touch", "type": "datetime", "index": true },
        "notes": { "label": "Notes", "type": "longtext" }
      }
    }
  },
  "capabilities": {
    "records": { "company": "rw", "deal": "rw" },
    "connectors": { "gmail": { "as": "member", "can": ["draft", "send"], "approve": ["send"] } },
    "ai": ["draft"],
    "tools": []
  },
  "triggers": [{ "id": "mondays", "on": "schedule", "cron": "0 9 * * 1", "run": "follow-up" }],
  "commands": [
    { "id": "nudge", "label": "Draft nudge", "for": "deal", "run": "follow-up", "params": { "deals": "$selection.deals.ids" } }
  ],
  "budget": { "month": 20, "currency": "USD", "per_run": 0.3, "at_cap": "ask", "models": ["deepseek/deepseek-v4.1-flash"] }
}
