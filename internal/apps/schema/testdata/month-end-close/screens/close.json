{
  "screen": "close",
  "title": "Close",
  "body": {
    "part": "Stack",
    "children": [
      {
        "part": "RecordList",
        "label": "Close queue",
        "props": {
          "columns": [
            "title"
          ],
          "select": "one"
        },
        "bind": {
          "records": "close"
        },
        "id": "close-list"
      },
      {
        "part": "Grid",
        "label": "Ledger reconciliation",
        "props": {
          "mode": "match",
          "match": {
            "with": "sheets/bank.csv",
            "keys": [
              "account"
            ]
          },
          "export": [
            "csv"
          ]
        },
        "bind": {
          "content-part": "sheets/ledger.csv"
        }
      },
      {
        "part": "Checklist",
        "label": "Review checklist",
        "props": {
          "checklist": "checks"
        },
        "bind": {
          "record": "$selection.close-list.id",
          "type": "close"
        }
      },
      {
        "part": "SignOff",
        "label": "Review signatures",
        "props": {
          "chain": "review"
        },
        "bind": {
          "record": "$selection.close-list.id",
          "type": "close"
        }
      }
    ]
  }
}
