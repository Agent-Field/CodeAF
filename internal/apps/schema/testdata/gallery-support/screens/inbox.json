{
  "screen": "inbox",
  "title": "Inbox",
  "body": {
    "part": "Row",
    "id": "workspace",
    "props": {
      "workspace": "queue",
      "gap": 2,
      "align": "stretch"
    },
    "children": [
      {
        "part": "RecordList",
        "id": "work",
        "label": "Open tickets",
        "props": {
          "columns": [
            "subject",
            "customer",
            "company",
            "received_at",
            "status"
          ],
          "select": "one",
          "meter": "status"
        },
        "bind": {
          "records": "ticket",
          "view": "work"
        }
      },
      {
        "part": "Panel",
        "id": "detail",
        "props": {
          "title": "Conversation"
        },
        "bind": {
          "selection": "work"
        },
        "children": [
          {
            "part": "Text",
            "id": "select-hint",
            "props": {
              "text": "Choose a ticket to read the conversation and reply.",
              "tone": "muted"
            },
            "when": "$selection.work.count == 0"
          },
          {
            "part": "RecordPage",
            "id": "record",
            "label": "Selected record",
            "props": {
              "fields": [
                "customer",
                "company",
                "status"
              ]
            },
            "bind": {
              "record": "$selection.work.id",
              "type": "ticket"
            },
            "when": "$selection.work.count == 1"
          },
          {
            "part": "Timer",
            "props": {
              "field": "reply_by",
              "direction": "down",
              "amber": "PT30M",
              "red": "PT0S"
            },
            "bind": {
              "record": "$selection.work.id",
              "type": "ticket"
            },
            "id": "timer",
            "when": "$selection.work.count == 1"
          },
          {
            "part": "Thread",
            "label": "Email thread",
            "props": {
              "messages": "body",
              "compose": true,
              "macros": [
                { "label": "Known issue", "text": "Thanks for letting us know. We are looking into this issue and will follow up here." },
                { "label": "Refund policy", "text": "I can look up the refund options for your order. Please share your order number." },
                { "label": "Reset 2FA", "text": "I can help you recover access. Please confirm which recovery option you still have." }
              ]
            },
            "bind": {
              "record": "$selection.work.id",
              "type": "ticket"
            },
            "id": "thread",
            "on": {
              "reply": [
                {
                  "runs.start": "reply",
                  "params": {
                    "thread": "$record.external_id",
                    "body": "$input.text"
                  }
                }
              ]
            },
            "when": "$selection.work.count == 1"
          },
          {
            "part": "Timeline",
            "id": "activity",
            "label": "Ticket activity",
            "bind": {
              "record": "$selection.work.id",
              "type": "ticket"
            },
            "when": "$selection.work.count == 1"
          }
        ]
      }
    ]
  },
  "views": {
    "work": {
      "type": "ticket",
      "window": {
        "order_by": [
          "received_at"
        ]
      }
    }
  }
}
