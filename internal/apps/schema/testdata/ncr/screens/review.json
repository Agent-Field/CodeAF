{
  "screen": "review",
  "title": "Disposition",
  "body": {
    "part": "Stack",
    "children": [
      {
        "part": "RecordList",
        "label": "Ncr queue",
        "props": {
          "columns": [
            "title"
          ],
          "select": "one"
        },
        "bind": {
          "records": "ncr",
          "view": "ncr-list"
        },
        "id": "ncr-list"
      },
      {
        "part": "RecordPage",
        "label": "Nonconformance details",
        "props": {
          "links": true
        },
        "bind": {
          "record": "$selection.ncr-list.id",
          "type": "ncr"
        },
        "id": "recordpage"
      },
      {
        "part": "FileViewer",
        "label": "Drawing revisions",
        "props": {
          "pins": true,
          "revisionCompare": true
        },
        "bind": {
          "file": "$selection.ncr-list.id",
          "type": "ncr",
          "field": "drawing"
        },
        "id": "fileviewer"
      },
      {
        "part": "SignOff",
        "label": "Review signatures",
        "props": {
          "chain": "review"
        },
        "bind": {
          "record": "$selection.ncr-list.id",
          "type": "ncr"
        },
        "id": "signoff"
      }
    ],
    "id": "stack"
  },
  "views": {
    "ncr-list": {
      "type": "ncr"
    }
  }
}
