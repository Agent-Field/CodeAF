{
  "id": "gallery-kyc",
  "name": "KYC review",
  "icon": "check",
  "version": 1,
  "kit": 2,
  "agent": {
    "name": "KYC review assistant",
    "file": "agent.md"
  },
  "records": {
    "case": {
      "title": "title",
      "fields": {
        "title": {
          "type": "text"
        },
        "pan": {
          "label": "PAN",
          "type": "text",
          "masked": true
        },
        "identity": {
          "type": "files"
        },
        "stage": {
          "type": "enum",
          "label": "Stage",
          "values": [
            "New",
            "Maker",
            "Checker",
            "Customer",
            "Done"
          ]
        },
        "maker": {
          "type": "person"
        },
        "reviewer": {
          "type": "person"
        },
        "case_number": {
          "type": "text",
          "label": "Case number"
        },
        "review": {
          "type": "text",
          "label": "Review"
        },
        "risk": {
          "type": "number",
          "label": "Risk score",
          "score_components": [
            "cash_business",
            "adverse_media",
            "source_of_funds"
          ],
          "score_reason": "risk_reason",
          "score_label": "risk_level"
        },
        "risk_level": {
          "type": "enum",
          "label": "Risk level",
          "values": ["Low", "Medium", "High"]
        },
        "cash_business": {
          "type": "number",
          "label": "Cash business"
        },
        "adverse_media": {
          "type": "number",
          "label": "Adverse media"
        },
        "source_of_funds": {
          "type": "number",
          "label": "Source of funds"
        },
        "risk_reason": {
          "type": "longtext",
          "label": "Review note"
        }
      },
      "present": {
        "title": "title",
        "meta": [
          "case_number",
          "review",
          "maker"
        ],
        "state": "stage",
        "trailing": "risk"
      },
      "lifecycle": {
        "field": "stage",
        "transitions": [
          {
            "id": "approve",
            "label": "Approve",
            "from": [
              "Checker"
            ],
            "to": "Done",
            "guard": "signed()"
          },
          {
            "id": "return",
            "label": "Return",
            "from": [
              "Checker"
            ],
            "to": "Maker"
          }
        ]
      }
    }
  },
  "capabilities": {
    "records": {
      "case": "rw"
    }
  },
  "policies": [
    {
      "id": "review",
      "kind": "signoff",
      "config": {
        "record": "case",
        "makerCannotSign": true,
        "roles": [
          {
            "id": "maker",
            "label": "Maker",
            "person": "$record.maker"
          },
          {
            "id": "checker",
            "label": "Independent reviewer",
            "person": "$record.reviewer"
          }
        ],
        "statement": "I have reviewed the attached evidence."
      }
    },
    {
      "id": "checks",
      "kind": "checklist",
      "config": {
        "record": "case",
        "signoff": "review",
        "steps": [
          {
            "id": "evidence",
            "label": "Check identity and face match",
            "evidence": "file",
            "role": "maker"
          },
          {
            "id": "address",
            "label": "Address proof is less than 3 months old",
            "evidence": "note",
            "role": "checker"
          },
          {
            "id": "sanctions",
            "label": "Confirm sanctions screening",
            "evidence": "note",
            "role": "checker"
          },
          {
            "id": "funds",
            "label": "Review source of funds",
            "evidence": "note",
            "role": "checker"
          }
        ]
      }
    },
    {
      "id": "privacy",
      "kind": "mask",
      "config": {
        "record": "case",
        "fields": [
          "pan"
        ],
        "reason": true
      }
    }
  ]
}
