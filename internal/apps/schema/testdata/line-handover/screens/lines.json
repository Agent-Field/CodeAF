{
  "screen": "lines",
  "title": "Lines",
  "body": {
    "part": "Stack",
    "children": [
      {
        "part": "RecordList",
        "label": "Line queue",
        "props": {
          "columns": [
            "title",
            "minutes",
            "stage"
          ],
          "select": "one"
        },
        "bind": {
          "records": "line",
          "view": "line-list"
        },
        "id": "line-list"
      },
      {
        "part": "Chart",
        "props": {
          "kind": "bar",
          "x": "shift",
          "y": "minutes"
        },
        "bind": {
          "records": "line",
          "view": "chart"
        },
        "id": "chart"
      }
    ],
    "id": "stack"
  },
  "views": {
    "line-list": {
      "type": "line"
    },
    "chart": {
      "type": "line"
    }
  }
}
