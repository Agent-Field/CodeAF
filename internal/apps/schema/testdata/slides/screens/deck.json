{
  "screen": "deck",
  "title": "Quarterly deck",
  "body": {
    "part": "Stack",
    "children": [
      {
        "part": "RecordList",
        "label": "Deck queue",
        "props": {
          "columns": [
            "title"
          ],
          "select": "one"
        },
        "bind": {
          "records": "deck",
          "view": "deck-list"
        },
        "id": "deck-list"
      },
      {
        "part": "Pages",
        "label": "Slides",
        "bind": {
          "content-part": "slides/1.json"
        },
        "id": "pages"
      },
      {
        "part": "Canvas",
        "label": "Slide editor",
        "props": {
          "theme": "acme",
          "frame": "16:9",
          "export": [
            "pdf",
            "pptx"
          ]
        },
        "bind": {
          "content-part": "slides/1.json"
        },
        "id": "canvas"
      }
    ],
    "id": "stack"
  },
  "views": {
    "deck-list": {
      "type": "deck"
    }
  }
}
