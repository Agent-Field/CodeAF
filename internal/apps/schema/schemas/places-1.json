{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/places-1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {"const": "Feature"},
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {"const": "Point"},
                  "coordinates": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "prefixItems": [
                      {"type": "number", "minimum": -180, "maximum": 180},
                      {"type": "number", "minimum": -90, "maximum": 90},
                      {"type": "number"}
                    ]
                  }
                },
                "required": ["type", "coordinates"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {"const": "LineString"},
                  "coordinates": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "prefixItems": [
                        {"type": "number", "minimum": -180, "maximum": 180},
                        {"type": "number", "minimum": -90, "maximum": 90},
                        {"type": "number"}
                      ]
                    }
                  }
                },
                "required": ["type", "coordinates"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {"const": "Polygon"},
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 3,
                        "prefixItems": [
                          {"type": "number", "minimum": -180, "maximum": 180},
                          {"type": "number", "minimum": -90, "maximum": 90},
                          {"type": "number"}
                        ]
                      }
                    }
                  }
                },
                "required": ["type", "coordinates"]
              }
            ]
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "record": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}/[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
              "live": {"type": "boolean"}
            },
            "required": ["label"]
          }
        },
        "required": ["type", "id", "geometry", "properties"]
      }
    }
  },
  "required": ["type", "features"]
}
