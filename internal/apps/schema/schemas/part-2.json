{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/part-2.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^custom/[a-z][a-z0-9_-]{0,47}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "object"
    },
    "props": {
      "type": "object"
    },
    "children": {
      "const": "none"
    },
    "interactive": {
      "type": "boolean"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["records", "record"] }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "uniqueItems": true,
      "maxItems": 12
    },
    "binding_required": {
      "const": true
    },
    "capabilities": {
      "const": "r"
    },
    "source": {
      "type": "string",
      "pattern": "^custom/[a-z][a-z0-9_-]{0,47}\\.tsx$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sizes": {
      "const": [
        800,
        1120
      ]
    },
    "themes": {
      "const": [
        "dark",
        "black",
        "light"
      ]
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 24,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "app",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string",
          "pattern": "^[0-9A-Z]{26}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "required": [
    "name",
    "version",
    "summary",
    "example",
    "props",
    "children",
    "interactive",
    "bindings",
    "events",
    "source",
    "reason",
    "sizes",
    "themes",
    "inputs",
    "binding_required",
    "capabilities"
  ]
}
