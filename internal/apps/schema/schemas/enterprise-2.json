{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/enterprise-2.json",
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "requester",
            "worker",
            "approver",
            "viewer",
            "admin",
            "custom"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "transition": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              }
            },
            "required": [
              "type",
              "transition"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "label"
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "transition": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              }
            },
            "required": [
              "type",
              "transition"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "label",
        "roles"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "assignment"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "workItem": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "strategy": {
          "enum": [
            "field",
            "round-robin",
            "load",
            "skill",
            "role",
            "linked-owner"
          ]
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "minItems": 1
        },
        "transition": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "ownerField": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        },
        "matches": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "kind",
        "record",
        "strategy",
        "workItem"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "field"
              }
            }
          },
          "then": {
            "required": [
              "field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "skill"
              }
            }
          },
          "then": {
            "required": [
              "skill"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "enum": [
                  "round-robin",
                  "load",
                  "role"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "roles"
                ]
              },
              {
                "required": [
                  "candidates"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "linked-owner"
              }
            }
          },
          "then": {
            "required": [
              "field",
              "ownerField"
            ]
          }
        },
        {
          "if": {
            "required": [
              "matches"
            ]
          },
          "then": {
            "properties": {
              "strategy": {
                "const": "field"
              }
            }
          }
        }
      ]
    },
    "approval-routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "approval-routing"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "enum": [
            "serial",
            "parallel"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "delegate": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "transition": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "priority": {
          "type": "integer"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "makerCannotSign": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "record",
        "order",
        "roles"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "booking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "resource": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "start": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "end": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "overlap": {
              "const": "reject"
            },
            "day": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "maxPerDay": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "resource"
          ],
          "oneOf": [
            {
              "required": [
                "start",
                "end",
                "overlap"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "day"
                    ]
                  },
                  {
                    "required": [
                      "maxPerDay"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "day",
                "maxPerDay"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "start"
                    ]
                  },
                  {
                    "required": [
                      "end"
                    ]
                  },
                  {
                    "required": [
                      "overlap"
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "required": [
        "label",
        "booking"
      ]
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "maxLength": 20
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "pad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    },
    "ledger": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reversal": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            }
          },
          "required": [
            "reversal"
          ]
        }
      ]
    },
    "channel": {
      "oneOf": [
        {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/form-link"
        },
        {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/email-in"
        },
        {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/webhook-in"
        },
        {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/file-drop"
        },
        {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/connector-event"
        }
      ]
    },
    "form-link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "form-link"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "form": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        }
      },
      "required": [
        "kind",
        "record",
        "form"
      ]
    },
    "email-in": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "email-in"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "connector": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "event": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "record",
        "connector",
        "event"
      ]
    },
    "webhook-in": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "webhook-in"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        }
      },
      "required": [
        "kind",
        "record",
        "run"
      ]
    },
    "file-drop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file-drop"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "form": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "record",
        "form"
      ]
    },
    "connector-event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "connector-event"
        },
        "record": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "connector": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "event": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "record",
        "connector",
        "event"
      ]
    }
  }
}
