{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/app-2.json",
  "title": "app.json",
  "description": "Registry-backed personal app definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kit",
    "records",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "A slug the Builder chose, or the ULID the app store assigned.",
      "anyOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "icon": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kit": {
      "const": 2
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "file"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        }
      }
    },
    "records": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/recordType"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records"
      ],
      "properties": {
        "records": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "r",
              "rw"
            ]
          }
        },
        "connectors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "can"
            ],
            "properties": {
              "as": {
                "enum": [
                  "me"
                ]
              },
              "account": {
                "type": "string"
              },
              "can": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/verb"
                },
                "minItems": 1
              },
              "approve": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/verb"
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ai": {
          "type": "array",
          "items": {
            "enum": [
              "sort",
              "summarise"
            ]
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "on",
          "run"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/name"
          },
          "on": {
            "type": "string"
          },
          "cron": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "connector": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "run": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/name"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "for": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "run": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "confirm": {
            "type": "string"
          },
          "do": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://codeaf.dev/schema/screen-2.json#/$defs/action"
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "month": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        },
        "per_run": {
          "type": "number",
          "minimum": 0
        },
        "at_cap": {
          "enum": [
            "ask",
            "stop"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "config"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "signoff"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "$ref": "https://codeaf.dev/schema/records-2.json#/$defs/signoff"
                }
              }
            }
          }
        ]
      }
    },
    "relations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "https://codeaf.dev/schema/records-2.json#/$defs/relation"
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          }
        }
      }
    },
    "process": {
      "$ref": "https://codeaf.dev/schema/process-2.json"
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/role"
      }
    },
    "audiences": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/audience"
      }
    },
    "channels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/channel"
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/assignment"
          },
          {
            "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/approval-routing"
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/resource"
      }
    }
  },
  "$defs": {
    "verb": {
      "description": "A connector verb, lowercase, so the outbound check reads it exactly as it is called.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "recordType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "common": {
          "$ref": "#/$defs/name"
        },
        "uses": {
          "type": "boolean"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "attribute"],
              "properties": {
                "field": {"type": "string"},
                "attribute": {"type": "string"}
              }
            },
            "fields": {
              "type": "object",
              "additionalProperties": {"enum": ["hide", "mask"]}
            }
          }
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "constants": {
          "type": "object"
        },
        "freeze": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "string"
              },
              "except": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "period": {
                "enum": [
                  "month",
                  "quarter",
                  "year"
                ]
              },
              "field": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            }
          }
        },
        "ledger": {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/ledger"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lifecycle": {
          "$ref": "https://codeaf.dev/schema/process-2.json#/$defs/record-lifecycle"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "default": {},
        "index": {
          "type": "boolean"
        },
        "class": {"enum": ["public", "internal", "confidential", "restricted", "pii"]},
        "masked": {
          "type": "boolean"
        },
        "computed": {
          "type": "string",
          "minLength": 1
        },
        "ai": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "to": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "blind": {
          "$ref": "https://codeaf.dev/schema/records-2.json#/$defs/blind"
        },
        "timer": {
          "$ref": "https://codeaf.dev/schema/records-2.json#/$defs/timer"
        },
        "sequence": {
          "$ref": "https://codeaf.dev/schema/enterprise-2.json#/$defs/sequence"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    }
  }
}
