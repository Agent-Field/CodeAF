{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/screen/1.json",
  "title": "screens/<id>.json",
  "description": "One screen of a codeaf app: a tree of kit parts with bindings, conditions and actions. Each part's props are checked against that part's own schema in kit-v0.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["screen", "title", "body"],
  "properties": {
    "$schema": { "type": "string" },
    "screen": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
    "title": { "type": "string", "minLength": 1 },
    "params": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "uniqueItems": true },
    "nav": { "$ref": "#/$defs/node" },
    "body": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part"],
      "properties": {
        "part": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
        "label": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bind": { "$ref": "#/$defs/bind" },
        "on": {
          "type": "object",
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
        },
        "when": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "records": { "type": "string" },
        "query": { "type": "string" },
        "record": { "type": "string" },
        "type": { "type": "string" },
        "selection": { "type": "string" },
        "run": { "type": "string" },
        "runs": { "type": "string" },
        "for": { "type": "string" }
      }
    },
    "action": {
      "description": "Exactly one verb (open, records.update, records.create, records.delete, runs.start, approve, tools.call, ai.sort, toast) plus that verb's modifiers.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "open": { "type": "string" },
        "id": { "type": "string" },
        "beside": { "type": "boolean" },
        "records.update": {
          "type": "object",
          "additionalProperties": false,
          "required": ["set"],
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "ids": { "type": "string" },
            "set": { "type": "object", "minProperties": 1 }
          }
        },
        "records.create": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "set": { "type": "object" }
          }
        },
        "records.delete": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "ids": { "type": "string" }
          }
        },
        "ask": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "runs.start": { "type": "string" },
        "params": { "type": "object" },
        "approve": { "type": "string" },
        "answer": { "enum": ["yes", "no"] },
        "tools.call": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "prefixItems": [{ "type": "string" }, { "type": "string" }, { "type": "object" }]
        },
        "ai.sort": { "type": "string" },
        "field": { "type": "string" },
        "toast": { "type": "string" },
        "confirm": { "type": "string" }
      }
    }
  }
}
