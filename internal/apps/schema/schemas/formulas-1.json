{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/formulas-1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sheets": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"pattern": "^[A-Z]+[1-9][0-9]*$"},
        "additionalProperties": {"type": "string", "pattern": "^=.+$"}
      }
    }
  },
  "required": ["sheets"]
}
