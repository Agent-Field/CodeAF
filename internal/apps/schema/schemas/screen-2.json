{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/screen-2.json",
  "title": "screens/<id>.json",
  "description": "A screen tree whose parts, props and events resolve through the app registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen",
    "title",
    "body"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "screen": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "nav": {
      "$ref": "#/$defs/node"
    },
    "body": {
      "$ref": "#/$defs/node"
    },
    "views": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "id"
      ],
      "properties": {
        "part": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "type": "object"
        },
        "bind": {
          "$ref": "#/$defs/bind"
        },
        "on": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/action"
            }
          }
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        }
      }
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "records": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "selection": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "runs": {
          "type": "string",
          "minLength": 1
        },
        "for": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "content-part": {
          "type": "string",
          "minLength": 1
        },
        "part-id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "view": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
        }
      },
      "oneOf": [
        {
          "required": [
            "records"
          ]
        },
        {
          "required": [
            "record"
          ]
        },
        {
          "required": [
            "selection"
          ]
        },
        {
          "required": [
            "params"
          ]
        },
        {
          "required": [
            "run"
          ]
        },
        {
          "required": [
            "runs"
          ]
        },
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "content-part"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "file"
            ]
          },
          "then": {
            "required": [
              "field"
            ]
          }
        },
        {
          "if": {
            "required": [
              "field"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "part-id"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "content-part"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "record"
                ]
              },
              {
                "required": [
                  "file"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "for"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "run"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "records"
            ]
          },
          "then": {
            "required": [
              "view"
            ]
          }
        },
        {
          "if": {
            "required": [
              "view"
            ]
          },
          "then": {
            "required": [
              "records"
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "minProperties": 1
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
        },
        "select": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
              },
              "value": {}
            },
            "required": [
              "field",
              "op",
              "value"
            ]
          }
        },
        "relate": {
          "$ref": "https://codeaf.dev/schema/records-2.json#/$defs/trace"
        },
        "group": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aggregate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "count",
                  "sum",
                  "avg",
                  "min",
                  "max"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "as": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
              }
            },
            "required": [
              "op",
              "as"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "sum",
                        "avg",
                        "min",
                        "max"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "field"
                  ]
                }
              }
            ]
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order_by": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_-]{0,47}|[0-9A-HJKMNP-TV-Z]{26})$"
          }
        }
      },
      "required": [
        "type"
      ]
    }
  }
}
