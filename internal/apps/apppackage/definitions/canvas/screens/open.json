{
  "screen": "open",
  "title": "Board",
  "params": [
    "id"
  ],
  "body": {
    "part": "Stack",
    "id": "open",
    "children": [
      {
        "part": "Row",
        "id": "navigation",
        "children": [
          {
            "part": "Button",
            "id": "back",
            "label": "Canvas",
            "props": {
              "kind": "secondary"
            },
            "on": {
              "click": [
                {
                  "open": "library"
                }
              ]
            }
          },
          {
            "part": "Button",
            "id": "export-pdf",
            "label": "Export PDF",
            "props": {
              "kind": "secondary"
            },
            "on": {
              "click": [
                {
                  "render": {
                    "output": "pdf",
                    "record": "$params.id"
                  }
                }
              ]
            }
          },
          {
            "part": "Button",
            "id": "details-button",
            "label": "Details",
            "props": {
              "kind": "secondary"
            },
            "on": {
              "click": [
                {
                  "open": "details-sheet"
                }
              ]
            }
          }
        ]
      },
      {
        "part": "custom/board-body",
        "id": "body",
        "label": "Board",
        "bind": {
          "record": "$params.id",
          "type": "canvas_board"
        },
        "on": {
          "edit": [
            {
              "records.update": {
                "type": "canvas_board",
                "id": "$record.id",
                "set": {
                  "body": "$input.value",
                  "x": "$input.x",
                  "y": "$input.y"
                }
              }
            }
          ]
        }
      },
      {
        "part": "Sheet",
        "id": "details-sheet",
        "label": "Details",
        "children": [
          {
            "part": "RecordPage",
            "id": "details",
            "label": "Board details",
            "bind": {
              "record": "$params.id",
              "type": "canvas_board"
            },
            "props": {
              "fields": [
                "title"
              ],
              "history": true,
              "actions": [
                "rename"
              ]
            }
          }
        ],
        "props": {
          "title": "Details"
        }
      }
    ]
  }
}
