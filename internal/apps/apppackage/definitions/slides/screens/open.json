{
  "screen": "open",
  "title": "Presentation",
  "params": [
    "id"
  ],
  "body": {
    "part": "Stack",
    "id": "open",
    "children": [
      {
        "part": "Row",
        "id": "navigation",
        "children": [
          {
            "part": "Button",
            "id": "back",
            "label": "Presentations",
            "props": {
              "kind": "quiet"
            },
            "on": {
              "click": [
                {
                  "open": "library"
                }
              ]
            }
          },
          {
            "part": "Menu",
            "id": "file",
            "label": "File",
            "props": {
              "items": []
            },
            "children": [
              {
                "part": "Button",
                "id": "export-pptx",
                "label": "Export PPTX",
                "props": {
                  "kind": "secondary"
                },
                "on": {
                  "click": [
                    {
                      "render": {
                        "output": "pptx",
                        "record": "$params.id"
                      }
                    }
                  ]
                }
              },
              {
                "part": "Button",
                "id": "export-pdf",
                "label": "Export PDF",
                "props": {
                  "kind": "secondary"
                },
                "on": {
                  "click": [
                    {
                      "render": {
                        "output": "pdf",
                        "record": "$params.id"
                      }
                    }
                  ]
                }
              },
              {
                "part": "Button",
                "id": "share",
                "label": "Copy text",
                "props": {
                  "kind": "secondary"
                },
                "on": {
                  "click": [
                    {
                      "render": {
                        "output": "share",
                        "record": "$params.id",
                        "clipboard": true
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "part": "Button",
            "id": "details-button",
            "label": "Details",
            "props": {
              "kind": "quiet"
            },
            "on": {
              "click": [
                {
                  "open": "details-sheet"
                }
              ]
            }
          }
        ]
      },
      {
        "part": "custom/slide-body",
        "id": "body",
        "label": "Slide",
        "bind": {
          "record": "$params.id",
          "type": "slides_slide"
        },
        "on": {
          "edit": [
            {
              "records.update": {
                "type": "slides_slide",
                "id": "$record.id",
                "set": {
                  "body": "$input.value",
                  "deck": "$input.deck"
                }
              }
            }
          ]
        }
      },
      {
        "part": "Sheet",
        "id": "details-sheet",
        "label": "Details",
        "children": [
          {
            "part": "RecordPage",
            "id": "details",
            "label": "Slide details",
            "bind": {
              "record": "$params.id",
              "type": "slides_slide"
            },
            "props": {
              "fields": [
                "title"
              ],
              "history": true,
              "actions": [
                "rename",
                "duplicate",
                "delete"
              ]
            }
          }
        ],
        "props": {
          "title": "Details"
        }
      }
    ]
  },
  "nav": {
    "part": "SectionTabs",
    "label": "Presentations",
    "props": {
      "items": [
        {
          "label": "Presentations",
          "screen": "library"
        }
      ]
    },
    "id": "home-tab"
  }
}
