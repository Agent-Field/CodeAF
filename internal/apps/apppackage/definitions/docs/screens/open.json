{
  "screen": "open",
  "title": "Document",
  "params": [
    "id"
  ],
  "body": {
    "part": "Stack",
    "id": "open",
    "children": [
      {
        "part": "Row",
        "id": "navigation",
        "children": [
          {
            "part": "Button",
            "id": "back",
            "label": "Docs",
            "props": {
              "kind": "secondary"
            },
            "on": {
              "click": [
                {
                  "open": "library"
                }
              ]
            }
          },
          {
            "part": "Button",
            "id": "export-pdf",
            "label": "Export PDF",
            "props": {
              "kind": "secondary"
            },
            "on": {
              "click": [
                {
                  "render": {
                    "output": "pdf",
                    "record": "$params.id"
                  }
                }
              ]
            }
          },
          {
            "part": "Button",
            "id": "export-docx",
            "label": "Export DOCX",
            "props": {
              "kind": "secondary"
            },
            "on": {
              "click": [
                {
                  "render": {
                    "output": "docx",
                    "record": "$params.id"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "part": "custom/document-body",
        "id": "body",
        "label": "Document",
        "bind": {
          "record": "$params.id",
          "type": "docs_document"
        },
        "on": {
          "edit": [
            {
              "records.update": {
                "type": "docs_document",
                "id": "$record.id",
                "set": {
                  "body": "$input.value"
                }
              }
            }
          ]
        }
      },
      {
        "part": "RecordPage",
        "id": "details",
        "label": "Document details",
        "bind": {
          "record": "$params.id",
          "type": "docs_document"
        },
        "props": {
          "fields": [
            "title"
          ],
          "history": true,
          "actions": [
            "rename"
          ]
        }
      }
    ]
  }
}
