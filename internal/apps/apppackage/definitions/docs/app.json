{
  "id": "01KAVYH000C0DEAF0000000001",
  "name": "Docs",
  "version": 1,
  "kit": 2,
  "records": {
    "document": {
      "label": "Document",
      "title": "title",
      "fields": {
        "title": {
          "type": "text",
          "required": true
        },
        "body": {
          "type": "longtext"
        }
      }
    }
  },
  "capabilities": {
    "records": {
      "document": "rw"
    }
  },
  "commands": [
    {
      "id": "new",
      "label": "New document",
      "do": [
        {
          "records.create": {
            "type": "document",
            "set": {
              "title": "$input.title"
            }
          },
          "ask": {
            "title": "text"
          }
        }
      ]
    },
    {
      "id": "edit-body",
      "label": "Edit contents",
      "do": [
        {
          "records.update": {
            "type": "document",
            "id": "$record.id",
            "set": {
              "body": "$input.body"
            }
          },
          "ask": {
            "body": "longtext"
          }
        }
      ],
      "for": "document"
    },
    {
      "id": "rename",
      "label": "Rename",
      "do": [
        {
          "records.update": {
            "type": "document",
            "id": "$record.id",
            "set": {
              "title": "$input.title"
            }
          },
          "ask": {
            "title": "text"
          }
        }
      ],
      "for": "document"
    },
    {
      "id": "duplicate",
      "label": "Duplicate",
      "for": "document",
      "run": "duplicate",
      "params": {
        "source": "$record.id"
      }
    }
  ],
  "outputs": {
    "pdf": {
      "label": "Export PDF",
      "format": "pdf",
      "record": "document",
      "body": "{{title}}\n\n{{body}}"
    },
    "docx": {
      "label": "Export DOCX",
      "format": "docx",
      "record": "document",
      "body": "{{title}}\n\n{{body}}"
    }
  }
}
