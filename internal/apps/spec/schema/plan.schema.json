{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeaf.dev/schema/plan/1.json",
  "title": "codeaf app plan (plan.json): what the plan card draws",
  "type": "object",
  "required": ["ask", "name", "data", "automation", "screens", "agent"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "ask": { "type": "string", "minLength": 1, "description": "The owner's paragraph, verbatim." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "tint": { "type": "string", "enum": ["iris", "sage", "sand", "tide", "rose", "graphite"] },
    "data": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
    "automation": { "type": "array", "items": { "$ref": "#/$defs/line" } },
    "screens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
    "agent": {
      "type": "object",
      "required": ["line"],
      "additionalProperties": false,
      "properties": { "id": { "const": "agent" }, "line": { "type": "string", "minLength": 1 } }
    },
    "needs": {
      "const": "computed",
      "description": "codeaf computes Needs from app.json; the Builder never writes them."
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "required": ["id", "line"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$", "description": "Record type, run or screen id this line becomes." },
        "line": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
