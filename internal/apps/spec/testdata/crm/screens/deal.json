{
  "$schema": "https://codeaf.dev/schema/screen/1.json",
  "screen": "deal",
  "title": "Deals",
  "params": [
    "id"
  ],
  "nav": {
    "part": "SectionTabs",
    "label": "CRM sections",
    "props": {
      "items": [
        "Pipeline",
        "Contacts"
      ]
    }
  },
  "body": {
    "part": "Stack",
    "children": [
      {
        "part": "RecordPage",
        "label": "Deals › {{record.name}}",
        "bind": {
          "record": "$params.id",
          "type": "deal"
        },
        "props": {
          "fields": [
            "name",
            "company",
            "contacts",
            "stage",
            "amount",
            "close_on",
            "owner",
            "last_touch",
            "weighted",
            "likely",
            "next_step"
          ],
          "history": true
        }
      },
      {
        "part": "Row",
        "children": [
          {
            "part": "Button",
            "label": "Draft follow-up",
            "on": {
              "click": [
                {
                  "runs.start": "follow-up",
                  "params": {
                    "deals": [
                      "$params.id"
                    ]
                  }
                }
              ]
            },
            "props": {
              "kind": "primary"
            }
          },
          {
            "part": "Button",
            "label": "Ask CRM agent about this deal",
            "props": {
              "kind": "quiet"
            },
            "on": {
              "click": [
                {
                  "agent.ask": "Summarise this deal and suggest the next step.",
                  "record": "$params.id"
                }
              ]
            }
          },
          {
            "part": "Button",
            "label": "Mark won…",
            "props": {
              "kind": "secondary"
            },
            "when": "$record.stage != 'Won'",
            "on": {
              "click": [
                {
                  "records.update": {
                    "id": "$params.id",
                    "set": {
                      "stage": "Won"
                    }
                  },
                  "confirm": "Mark {{record.name}} won?"
                }
              ]
            }
          },
          {
            "part": "Button",
            "label": "Back to deals",
            "props": {
              "kind": "quiet"
            },
            "on": {
              "click": [
                {
                  "open": "pipeline"
                }
              ]
            }
          },
          {
            "part": "Menu",
            "label": "More deal actions",
            "children": [
              {
                "part": "Button",
                "label": "Delete deal…",
                "props": {
                  "kind": "destructive"
                },
                "on": {
                  "click": [
                    {
                      "records.delete": {
                        "id": "$params.id"
                      },
                      "confirm": "Delete {{record.name}}?"
                    },
                    {
                      "open": "pipeline"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "part": "Text",
        "props": {
          "text": "Approvals",
          "size": "small",
          "tone": "neutral"
        }
      },
      {
        "part": "ApprovalCard",
        "label": "Approvals for this app",
        "bind": {
          "approvals": "open"
        },
        "slots": {
          "empty": {
            "part": "Empty",
            "props": {
              "text": "No approvals waiting. Draft a follow-up to prepare an email for approval."
            }
          }
        }
      },
      {
        "part": "Text",
        "props": {
          "text": "Follow-up runs",
          "size": "small",
          "tone": "neutral"
        }
      },
      {
        "part": "RunTimeline",
        "bind": {
          "run": "follow-up",
          "for": "$params.id"
        },
        "slots": {
          "empty": {
            "part": "Empty",
            "props": {
              "text": "No follow-up runs yet. Choose Draft follow-up to start one."
            }
          }
        }
      }
    ]
  }
}
