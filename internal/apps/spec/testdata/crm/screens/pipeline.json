{
  "$schema": "https://codeaf.dev/schema/screen/1.json",
  "screen": "pipeline",
  "title": "Pipeline",
  "params": [
    "view"
  ],
  "nav": {
    "part": "SectionTabs",
    "label": "CRM sections",
    "props": {
      "items": [
        "Pipeline",
        "Contacts"
      ],
      "placement": "views"
    }
  },
  "body": {
    "part": "Stack",
    "children": [
      {
        "part": "RecordList",
        "id": "deals",
        "label": "Deals",
        "bind": {
          "records": "deal",
          "query": "stage:-Won,Lost has:owner"
        },
        "props": {
          "views": [
            "List",
            "Board by stage"
          ],
          "groupBy": "stage",
          "columns": [
            "company",
            "name",
            "stage",
            "next_step",
            "amount",
            "last_touch"
          ]
        },
        "on": {
          "open": [
            {
              "open": "deal",
              "id": "$row.id"
            }
          ]
        },
        "slots": {
          "empty": {
            "part": "Empty",
            "props": {
              "text": "No deals yet"
            }
          }
        },
        "children": [
          {
            "part": "FilterTokens",
            "label": "Filter deals",
            "props": {
              "labels": [
                "stage:open",
                "owner:team"
              ],
              "placeholder": "Search deals · company: value: touched:",
              "sort": "Likely to close",
              "ai": true
            },
            "on": {
              "sort": [
                {
                  "ai.sort": "deals",
                  "field": "likely"
                }
              ]
            }
          },
          {
            "part": "StatStrip",
            "props": {
              "field": "stage"
            },
            "bind": {
              "records": "deal"
            }
          },
          {
            "part": "ScreenSubtitle",
            "props": {
              "noun": "open deals",
              "phrase": "likely to close ↓ · your pin first",
              "hint": "j / k · ↵ open · P pin"
            }
          }
        ]
      },
      {
        "part": "BulkBar",
        "when": "$selection.deals.count > 0",
        "props": {
          "list": "deals"
        },
        "children": [
          {
            "part": "Button",
            "label": "Move to…",
            "on": {
              "click": [
                {
                  "records.update": {
                    "ids": "$selection.deals.ids",
                    "set": {
                      "stage": "$input.stage"
                    }
                  },
                  "ask": {
                    "stage": "enum"
                  }
                }
              ]
            }
          },
          {
            "part": "Button",
            "label": "Draft follow-ups",
            "on": {
              "click": [
                {
                  "runs.start": "follow-up",
                  "params": {
                    "deals": "$selection.deals.ids"
                  }
                }
              ]
            }
          },
          {
            "part": "Button",
            "label": "Likely to close · AI",
            "on": {
              "click": [
                {
                  "ai.sort": "deals",
                  "field": "likely"
                }
              ]
            }
          }
        ]
      },
      {
        "part": "Panel",
        "label": "Selected deal",
        "when": "$selection.deals.count == 1",
        "children": [
          {
            "part": "RecordPage",
            "bind": {
              "record": "$selection.deals.id",
              "type": "deal"
            },
            "props": {
              "fields": [
                "stage",
                "amount",
                "next_step",
                "close_on",
                "owner",
                "weighted",
                "likely"
              ],
              "actions": [
                "follow-up",
                "mark-won"
              ]
            },
            "label": "Selected deal details"
          }
        ]
      }
    ],
    "props": {
      "align": "stretch"
    }
  }
}
