{
  "$schema": "https://codeaf.dev/schema/app/1.json",
  "id": "crm",
  "name": "CRM",
  "tint": "sage",
  "description": "Sales pipeline: companies, deals and contacts. The agent drafts follow-ups; every email waits for approval.",
  "space": "personal",
  "version": 1,
  "kit": 2,
  "agent": {
    "name": "CRM agent",
    "file": "agent.md",
    "model": "deepseek/deepseek-v4.1-flash"
  },
  "records": {
    "company": {
      "label": "Company",
      "plural": "Companies",
      "title": "name",
      "fields": {
        "name": {
          "type": "text",
          "required": true,
          "unique": true,
          "label": "Company name"
        },
        "domain": {
          "type": "url",
          "index": true,
          "label": "Website"
        },
        "size": {
          "type": "enum",
          "values": [
            "1-10",
            "11-50",
            "51-200",
            "201+"
          ],
          "label": "Company size"
        },
        "owner": {
          "type": "person",
          "default": "$me",
          "label": "Owner"
        }
      }
    },
    "contact": {
      "label": "Contact",
      "plural": "Contacts",
      "title": "name",
      "fields": {
        "name": {
          "type": "text",
          "required": true,
          "label": "Contact name"
        },
        "email": {
          "type": "email",
          "index": true,
          "label": "Email"
        },
        "phone": {
          "type": "phone",
          "masked": true,
          "label": "Phone"
        },
        "company": {
          "type": "ref",
          "to": "company",
          "index": true,
          "label": "Company"
        }
      }
    },
    "deal": {
      "label": "Deal",
      "plural": "Deals",
      "title": "name",
      "fields": {
        "name": {
          "type": "text",
          "required": true,
          "label": "Deal"
        },
        "company": {
          "type": "ref",
          "to": "company",
          "required": true,
          "index": true,
          "label": "Company"
        },
        "contacts": {
          "type": "refs",
          "to": "contact",
          "label": "Contacts"
        },
        "stage": {
          "type": "enum",
          "default": "Lead",
          "index": true,
          "values": [
            "Lead",
            "Talking",
            "Proposal",
            "Won",
            "Lost"
          ],
          "label": "Stage",
          "required": true
        },
        "amount": {
          "type": "money",
          "currency": "USD",
          "label": "Value",
          "required": true
        },
        "close_on": {
          "type": "date",
          "label": "Close date"
        },
        "owner": {
          "type": "person",
          "default": "$me",
          "label": "Owner"
        },
        "last_touch": {
          "type": "datetime",
          "index": true,
          "label": "Touch"
        },
        "weighted": {
          "type": "money",
          "computed": "amount * stage_weight[stage]",
          "label": "Weighted value"
        },
        "likely": {
          "type": "enum",
          "values": [
            "Likely",
            "Maybe",
            "Unlikely"
          ],
          "ai": "likely to close this month",
          "label": "Likely to close · AI"
        },
        "next_step": {
          "type": "text",
          "label": "Next step",
          "required": true
        }
      },
      "constants": {
        "stage_weight": {
          "Lead": 0.1,
          "Talking": 0.3,
          "Proposal": 0.5,
          "Won": 1,
          "Lost": 0
        }
      }
    }
  },
  "capabilities": {
    "records": {
      "deal": "rw",
      "company": "rw",
      "contact": "rw"
    },
    "connectors": {
      "gmail": {
        "as": "member",
        "can": [
          "read",
          "draft",
          "send"
        ],
        "approve": [
          "send"
        ]
      }
    },
    "ai": [
      "sort",
      "summarise",
      "draft"
    ],
    "tools": []
  },
  "triggers": [
    {
      "id": "proposal-sent",
      "on": "record.changed",
      "type": "deal",
      "when": "changed('stage') && stage == 'Proposal'",
      "run": "follow-up",
      "params": {
        "deals": [
          "$record.id"
        ]
      }
    }
  ],
  "commands": [
    {
      "id": "follow-up",
      "label": "Draft follow-up",
      "for": "deal",
      "run": "follow-up",
      "params": {
        "deals": "$selection.deals.ids"
      }
    },
    {
      "id": "mark-won",
      "label": "Mark won…",
      "for": "deal",
      "confirm": "Mark {{count}} deals won?",
      "do": [
        {
          "records.update": {
            "ids": "$selection.deals.ids",
            "set": {
              "stage": "Won"
            }
          }
        }
      ]
    }
  ],
  "budget": {
    "month": 20,
    "currency": "USD",
    "per_run": 0.5,
    "at_cap": "ask",
    "models": [
      "deepseek/deepseek-v4.1-flash"
    ]
  }
}
