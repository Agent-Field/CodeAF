{
  "openrouter": {
    "id": "openrouter",
    "name": "OpenRouter",
    "env": ["OPENROUTER_API_KEY"],
    "models": {
      "fixture/vendor-model": {
        "id": "fixture/vendor-model",
        "name": "Fixture Vendor Model",
        "family": "fixture",
        "release_date": "2026-01-01",
        "attachment": true,
        "reasoning": true,
        "temperature": true,
        "tool_call": true,
        "cost": {
          "input": 1.25,
          "output": 4.5,
          "cache_read": 0.125,
          "cache_write": 1.5,
          "context_over_200k": {
            "input": 2.5,
            "output": 9,
            "cache_read": 0.25,
            "cache_write": 3
          }
        },
        "limit": {
          "context": 240000,
          "input": 220000,
          "output": 12000
        },
        "modalities": {
          "input": ["text", "image"],
          "output": ["text"]
        }
      },
      "fixture/no-cost": {
        "id": "fixture/no-cost",
        "name": "Fixture Model Without Cost",
        "release_date": "2026-01-01",
        "attachment": false,
        "reasoning": false,
        "temperature": true,
        "tool_call": true,
        "limit": {
          "context": 64000,
          "output": 4096
        }
      }
    }
  }
}
