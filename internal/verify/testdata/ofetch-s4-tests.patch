+    resetCircuitStates();
+  });
+
+  // ---------- State transitions ----------
+
+  it("transitions from closed to open after threshold failures", async () => {
+    const fetch = mockFetch(new Map([
+      ["http://example.com/api", new Error("Network error")],
+    ]));
+    const $fetch = createFetch({ fetch });
+
+    for (let i = 0; i < 5; i++) {
+      await expect(
+        $fetch("http://example.com/api", { circuitBreaker: true })
+      ).rejects.toThrow();
+    }
+
+    // 6th call should fail fast with circuit breaker message
+    await expect(
+      $fetch("http://example.com/api", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+  });
+
+  it("transitions from open to half-open after cooldown", async () => {
+    vi.useFakeTimers();
+    const fetch = mockFetch(new Map([
+      ["http://example.com/api", new Error("Network error")],
+    ]));
+    const $fetch = createFetch({ fetch });
+
+    for (let i = 0; i < 5; i++) {
+      await expect(
+        $fetch("http://example.com/api", { circuitBreaker: true })
+      ).rejects.toThrow();
+    }
+
+    // Still open
+    await expect(
+      $fetch("http://example.com/api", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+
+    // Advance past cooldown
+    vi.advanceTimersByTime(30001);
+
+    // Should now be half-open — but still fails because the mock still errors
+    await expect(
+      $fetch("http://example.com/api", { circuitBreaker: true })
+    ).rejects.toThrow();
+
+    vi.useRealTimers();
+  });
+
+  it("transitions from half-open to closed on successful probe", async () => {
+    vi.useFakeTimers();
+    let callCount = 0;
+    const fetch = vi.fn(async () => {
+      callCount++;
+      if (callCount <= 5) {
+        throw new Error("Network error");
+      }
+      return new Response("ok", { status: 200 });
+    }) as unknown as typeof globalThis.fetch;
+    const $fetch = createFetch({ fetch });
+
+    // 5 failures to open circuit
+    for (let i = 0; i < 5; i++) {
+      await expect(
+        $fetch("http://example.com/api", { circuitBreaker: true })
+      ).rejects.toThrow();
+    }
+
+    // Advance past cooldown
+    vi.advanceTimersByTime(30001);
+
+    // Half-open probe succeeds — should close circuit
+    const result = await $fetch("http://example.com/api", {
+      circuitBreaker: true,
