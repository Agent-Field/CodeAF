{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for codeaf's own windows: main and every w-<n> it opens. Web page views (web-*) are deliberately absent.",
  "windows": [
    "main",
    "w-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*/api/engine/*"
        },
        {
          "url": "http://localhost:*/api/engine/*"
        }
      ]
    }
  ]
}
