{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codeaf",
  "version": "0.1.0",
  "identifier": "com.codeaf.desktop",
  "build": {
    "beforeDevCommand": "npm run engine:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run engine:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "codeaf",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/codeaf-engine"
    ]
  }
}
