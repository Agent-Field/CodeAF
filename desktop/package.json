{
  "name": "codeaf-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:remote": "node scripts/desktop.mjs remote",
    "desktop:build": "node scripts/desktop.mjs build",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:test": "cd .. && go test ./internal/desktopbridge",
    "scroll:test": "node --test --experimental-strip-types src/features/tabs/scroll/*.test.ts",
    "check": "npm run build && npm run design:test && npm run files:test && npm run scroll:test && npm run menu:test && npm run workspace-sync:test && npm run stale:test && npm run engine:test",
    "menu:test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "files:test": "node --test --experimental-strip-types src/features/files/*.test.ts",
    "workspace-sync:test": "node --test --experimental-strip-types src/features/workspace-sync/*.test.ts",
    "stale:test": "node --test --experimental-strip-types src/features/places/stale-client.test.ts",
    "design:generate": "node scripts/generate-design.mjs",
    "design:check": "node scripts/check-design.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "predev": "npm run design:generate",
    "prebuild": "npm run design:check",
    "design:test": "node --test scripts/check-design.test.mjs",
    "test:ui": "playwright test",
    "test:places-components": "playwright test --config playwright.places-components.config.ts",
    "test:places-home": "playwright test --config playwright.places-home.config.ts",
    "test:using": "playwright test --config playwright.using.config.ts",
    "test:workspace-sync": "playwright test --config playwright.workspace-sync.config.ts",
    "upstream:sync": "node scripts/sync-dev.mjs",
    "engine:dev": "node scripts/engine-bridge.mjs"
  },
  "dependencies": {
    "@animateicons/react": "0.12.0",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-select": "^2.3.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "2.8.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "0.460.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
