# Copy to .env (./setup.sh does that and fills the secrets), or set these in the environment.
# Nothing in this file is baked into an image.

# --- Secrets: ./setup.sh generates these. Treat .env like a password file. ---
# The AgentField control plane's API key. Every node and the factory present it.
AGENTFIELD_API_KEY=
# The organization server's break-glass access token (optional: the server makes its own
# on first start and keeps it in its volume; set this only to know it ahead of time).
CODEAF_FACTORY_TOKEN=

# --- Hosted chats (optional; read README.md "Hosted chats" first) ---
# The secret the organization server and the hosted-chats machine share. ./setup.sh generates it.
CODEAF_HOSTED_SECRET=
# To turn hosted chats on: set COMPOSE_PROFILES=hosted (this starts the sessionhost service) and
# CODEAF_HOSTED_URL=http://sessionhost:8790, then give the chats a model door: the organization's model
# endpoint in CODEAF_HOSTED_MODEL_UPSTREAM (for OpenRouter: https://openrouter.ai/api/v1) and its key in
# CODEAF_HOSTED_MODEL_KEY. Left empty, the organization server behaves exactly as it always did.
COMPOSE_PROFILES=
CODEAF_HOSTED_URL=
CODEAF_HOSTED_MODEL_UPSTREAM=
CODEAF_HOSTED_MODEL_KEY=

# --- Model keys: yours. Leave empty for the keyless smoke test. ---
OPENROUTER_API_KEY=
# A GitHub token the nodes use to clone, push and open pull requests (optional).
GH_TOKEN=

# --- The organization ---
CODEAF_ORG_NAME=codeaf organization
# The public host name (no scheme) when an HTTPS proxy in front serves it. Empty on a laptop.
CODEAF_PUBLIC_DOMAIN=
# GitHub sign-in for people (optional): the client id of a GitHub OAuth app with device flow on.
CODEAF_GITHUB_CLIENT_ID=
# Comma-separated addresses or CIDR ranges of the proxy in front, whose forwarding headers to believe.
CODEAF_TRUSTED_PROXIES=
# Invitation mail (optional): smtp://user:pass@host:587 and the sender. Without it an invite is a link to copy.
CODEAF_SMTP_URL=
CODEAF_SMTP_FROM=

# --- Models ---
ORG_MODEL=deepseek/deepseek-v4-flash-0731
SWE_DEFAULT_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
PR_AF_MODEL=deepseek/deepseek-v4-flash-0731

# --- Network ---
# Where the published ports listen. 127.0.0.1 keeps them on this machine; 0.0.0.0 opens them.
CODEAF_BIND=127.0.0.1
CODEAF_PORT=8787
AGENTFIELD_BIND=127.0.0.1
AGENTFIELD_PORT=8080

# --- AgentField ---
# Strict run-owner proofs. Leave true.
AGENTFIELD_RUN_OWNER_REQUIRE_PROOF=true
