# Run the stack from the PUBLISHED images instead of building it (README.md "Published images"):
#
#     docker compose --env-file .env --env-file images.env pull
#     docker compose --env-file .env --env-file images.env up -d --no-build
#
# Nothing in this file is a secret and none is baked into an image; keys still come from .env or your environment.
#
# ORG_REGISTRY is whose Docker Hub namespace (or registry path) the images come from: the organization's own by default,
# or yours if you build and push them yourself (the workflow .github/workflows/org-images.yml does it for a repository
# that has DOCKERHUB_USERNAME and DOCKERHUB_TOKEN secrets and a DOCKERHUB_NAMESPACE variable):
#     ORG_REGISTRY=ghcr.io/my-org docker compose --env-file .env --env-file images.env pull   (or put it in .env)
# ORG_TAG is the tag: `dev` follows the dev branch; a 12-character commit id is one exact build. Pin one for anything you
# keep running, and read the commit it names from the image's label (README.md "Published images").
ORG_REGISTRY=${ORG_REGISTRY:-agentfield}
ORG_TAG=${ORG_TAG:-dev}

CODEAF_ORG_IMAGE=${ORG_REGISTRY}/codeaf-org:${ORG_TAG}
AGENTFIELD_ORG_IMAGE=${ORG_REGISTRY}/codeaf-org-agentfield:${ORG_TAG}
SWE_AF_ORG_IMAGE=${ORG_REGISTRY}/codeaf-org-swe-af:${ORG_TAG}
PR_AF_ORG_IMAGE=${ORG_REGISTRY}/codeaf-org-pr-af:${ORG_TAG}
MODELSTUB_ORG_IMAGE=${ORG_REGISTRY}/codeaf-org-modelstub:${ORG_TAG}
GITSTUB_ORG_IMAGE=${ORG_REGISTRY}/codeaf-org-gitstub:${ORG_TAG}
