# Keyless smoke test: layered over .env by `docker compose --env-file .env --env-file .env.stub --profile stub up`.
# Every model call goes to the scripted stub, so nothing is spent and no key is needed.
# The stub produces minimal schema-valid answers, not real work.
CODEAF_BASE_URL=http://modelstub:8890/api/v1
OPENROUTER_API_KEY=stub-key
ORG_MODEL=stub/scripted
SWE_DEFAULT_MODEL=openrouter/stub/scripted
PR_AF_MODEL=stub/scripted
SWE_SMOKE_FIXTURE_REPO=/workspaces/smoke-fixture
