# Layered over .env and .env.stub by `SMOKE_HOSTED=1 ./smoke.sh`: it turns on hosted chats against the
# scripted stub, so every chat's model call is answered by the stub and spends nothing.
# It needs an image whose codeaf has `codeaf sessionhost` in it: see "Hosted chats" in README.md.
CODEAF_HOSTED_URL=http://sessionhost:8790
CODEAF_HOSTED_MODEL_UPSTREAM=http://modelstub:8890/api/v1
CODEAF_SESSIONHOST_MODEL=stub/scripted
# A short idle window and small limits so the smoke test can watch them work.
CODEAF_SESSIONHOST_IDLE=20s
CODEAF_SESSIONHOST_MAX_RUNNING=4
CODEAF_SESSIONHOST_MAX_PER_PERSON=2
