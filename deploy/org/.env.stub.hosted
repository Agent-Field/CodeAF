# Layered over .env and .env.stub by `SMOKE_HOSTED=1 ./smoke.sh`: it turns on hosted chats against the
# scripted stub, so every chat's model call is answered by the stub and spends nothing.
# It needs an image whose codeaf has `codeaf sessionhost` in it: see "Hosted chats" in README.md.
CODEAF_HOSTED_URL=http://sessionhost:8790
CODEAF_HOSTED_MODEL_UPSTREAM=http://modelstub:8890/api/v1
CODEAF_SESSIONHOST_MODEL=stub/scripted
# A short idle window and small limits so the smoke test can watch them work.
CODEAF_SESSIONHOST_IDLE=20s
# The machine-wide limit leaves room for every section: a chat whose engine started a storage helper keeps its slot until the stack restarts.
CODEAF_SESSIONHOST_MAX_RUNNING=10
CODEAF_SESSIONHOST_MAX_PER_PERSON=2
# P1: a model key of the hosted chats' own (the stub's, not a secret) so the stub's record shows exactly what they spent; each call
# reports it cost a cent, so metering is checked to the cent; a chat's cap is low enough to reach and high enough that the
# ordinary checks never do. The git host the smoke test clones from is the stub's.
CODEAF_HOSTED_MODEL_KEY=stub-hosted-org-key-0001
STUB_COST_USD=0.01
CODEAF_HOSTED_SESSION_CAP_USD=0.50
CODEAF_HOSTED_GIT_HOSTS=http://gitstub:8891
# P2: a guest's open window is checked every second, so the smoke test can watch a removed right end the window quickly.
CODEAF_HOSTED_HEARTBEAT=1s
